---
// Fallback ambiental (Task 16): respiración + parpadeo + vaivén de cola en
// CSS puro. Es el que se ve siempre que `rive` no está pedido, mientras
// `public/brand/mono.riv` no existe o no cargó todavía, y siempre —sin
// excepción— bajo prefers-reduced-motion (eso lo decide MascotaRive.tsx en
// el cliente; acá no hay forma de saberlo en build/SSR).
import { svgDeMarca } from './svg-inline'
import MascotaRive from './MascotaRive'
import '@/styles/mascota-ambiental.css'
import { copy } from '@/copy/marca'

// `class` se mantiene: Bandas.astro (Task 17) ya lo usa.
interface Props { rive?: boolean; class?: string }
const { rive = false, class: clase = '' } = Astro.props

// mascota.svg no trae width/height propio (solo viewBox 1024×1024).
// Sin esto, el <svg> inyectado ignora la clase Tailwind de altura de quien
// llama (`h-40`, `h-56`...) y se autodimensiona con el algoritmo de
// reemplazo del navegador — medido en vivo en 696×696 (tapando texto en
// tres páginas del manual) y en 0×0 en el hero de la portada (flex item
// sin ancho propio).
// Fix (Task 17, fix round 1): el <svg> llena el 100%×100% del contenedor,
// mismo mecanismo que SelloCircular.astro (el único de los otros cinco
// componentes de SVG de marca que fija width Y height al 100% — los demás
// solo fijan un ancho, o una altura, nunca los dos), y el contenedor fija
// aspect-ratio:1/1 (el viewBox es cuadrado) para que la altura de la clase
// determine también el ancho. El mismo string dimensionado viaja como
// fallback a la isla de Rive — que necesita el mismo fix de tamaño en sus
// propios contenedores, ver MascotaRive.tsx (fix B3, review final).
const svg = svgDeMarca('mascota').replace('<svg', '<svg width="100%" height="100%"')
---
{rive ? (
  <MascotaRive client:visible src="/brand/mono.riv" fallback={svg} class={clase} />
) : (
  <div
    class={`mascota ${clase}`}
    style="aspect-ratio:1/1"
    role="img"
    aria-label={copy.mascotaAria}
    set:html={svg}
  />
)}
