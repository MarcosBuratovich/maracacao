---
import { svgDeMarca } from './svg-inline'
import { copy } from '@/copy/marca'

interface Props { alto?: number }
const { alto = 44 } = Astro.props

// Ninguno de los tres SVG trae width/height propio (solo viewBox): sin
// fijarlos acá, el tamaño de reemplazo por defecto de un <svg> sin medidas
// es indefinido entre navegadores y no responde al contenedor (un <span>
// con `items-end`/`items-center`, no `stretch`, no fuerza el tamaño del
// hijo). Se fija la altura de cada SVG explícitamente — igual criterio que
// ya usa Logotipo.astro — y se deja el ancho "auto": el navegador lo
// calcula con el aspect ratio del propio viewBox.
//
// Proporciones del lockup: logotipo a la mitad de la altura de la cabeza,
// descriptor más chico todavía. Jerarquía tipográfica del §8 del spec: la
// voz dibujada (cabeza + logotipo) manda, el descriptor es la voz
// secundaria en serif — y además es lo primero que se oculta bajo 640px.
const altoLogotipo = Math.round(alto * 0.5)
const altoDescriptor = Math.round(alto * 0.3)

const cabeza = svgDeMarca('mascota-reducida').replace('<svg', `<svg height="${alto}"`)

// Fix de integración (Task 17) sobre un componente de la Task 15. El
// lettering de logotipo.svg/descriptor.svg va en fill crema fijo — su
// `<style>.letra{fill:...}` tokeniza a var(--mrc-crema, #F4E8C6) — pensado
// para "texto crema sobre banda verde" (paresAprobados, AAA), nunca para
// banda clara. Este header vive sobre banda clara (ver index.astro y
// manual/[...slug].astro), así que el crema crudo daba un contraste
// ≈1.10 contra el papel: el lettering quedaba prácticamente invisible,
// justo lo opuesto al criterio de aceptación 3 del spec ("el logo se lee
// a 32 px y a tres metros"). Misma técnica que Monocromo.astro ya usa
// para currentColor, adaptada de atributo `fill="..."` a la propiedad CSS
// `fill:...;` del <style> embebido de estos dos SVG en particular. El
// color se fija acá con el rol de texto-título sobre banda clara
// (`--mrc-rol-texto-titulo`, verde-700, contraste 8.61 AAA sobre papel —
// el mismo par que ya aprueba `paresAprobados` para "títulos sobre banda
// clara"). La cabeza (mascota-reducida) no se toca: sus fills son
// literales por forma, no CSS de clase, y ya están aprobados sobre papel.
const logotipo = svgDeMarca('logotipo')
  .replace(/fill:\s*var\(--mrc-[a-z0-9-]+,\s*#[0-9A-Fa-f]{6}\);/, 'fill: currentColor;')
  .replace('<svg', `<svg height="${altoLogotipo}"`)
const descriptor = svgDeMarca('descriptor')
  .replace(/fill:\s*var\(--mrc-[a-z0-9-]+,\s*#[0-9A-Fa-f]{6}\);/, 'fill: currentColor;')
  .replace('<svg', `<svg height="${altoDescriptor}"`)
---
<a href="/" class="flex items-center gap-3" aria-label={copy.logoAria}>
  <span class="shrink-0" style={`height:${alto}px`} set:html={cabeza} />
  <span class="flex flex-col" style="color:var(--mrc-rol-texto-titulo)">
    <span set:html={logotipo} />
    <span class="descriptor hidden sm:block" set:html={descriptor} />
  </span>
</a>
