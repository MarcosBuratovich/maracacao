---
// Barra de chocolate en 3D real, con el arte de envoltura del diseñador
// en sus caras.
//
// Por qué CSS 3D y no WebGL: una barra ES una caja. Seis caras con
// `transform-style: preserve-3d` dan perspectiva, giro y profundidad de
// verdad, sin sumar una librería de 150 kB ni un canvas que no se puede
// seleccionar ni indexar. El frente y el dorso son las imágenes reales
// extraídas del PDF (`scripts/extrae-envolturas.py`); los cantos toman el
// color exacto del diseño, aclarado y oscurecido para simular la luz.
//
// El giro lo maneja `editorial.ts`: sigue el scroll, y con puntero fino
// también el mouse. Con `prefers-reduced-motion` queda quieta, apenas
// girada, que es como se ve un producto en una foto.
interface Props {
  sabor: string        // clave del archivo y del token de color
  nombre: string
  alt: string
  class?: string
}
const { sabor, nombre, alt, class: clase = '' } = Astro.props
---
<div class={`barra3d ${clase}`} data-barra3d style={`--tinta-sabor: var(--mrc-sabor-${sabor})`}>
  <div class="barra3d-caja">
    <img class="barra3d-cara barra3d-frente" src={`/sitio/envoltura/${sabor}-frente.webp`} alt={alt} width="1041" height="1788" loading="lazy" />
    <img class="barra3d-cara barra3d-dorso" src={`/sitio/envoltura/${sabor}-dorso.webp`} alt="" aria-hidden="true" width="1041" height="1788" loading="lazy" />
    <div class="barra3d-cara barra3d-canto barra3d-izq"></div>
    <div class="barra3d-cara barra3d-canto barra3d-der"></div>
    <div class="barra3d-cara barra3d-canto barra3d-arriba"></div>
    <div class="barra3d-cara barra3d-canto barra3d-abajo"></div>
  </div>
  <span class="barra3d-sombra" aria-hidden="true"></span>
  <span class="sr-only">{nombre}</span>
</div>
