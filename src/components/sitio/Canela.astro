---
// Par de rajas de canela cruzadas — los sabores de especia (canela,
// cardamomo, jengibre) son parte del catálogo real. Decorativa, quieta.
interface Props { class?: string }
const { class: clase = '' } = Astro.props
---
<div class={`canela ${clase}`} style="aspect-ratio:2/1" aria-hidden="true">
  <svg viewBox="0 0 240 120" width="100%" height="100%" fill="none">
    <g transform="rotate(-14 120 60)">
      <rect x="30" y="46" width="180" height="28" rx="14"
        fill="var(--mrc-tan-700)" stroke="var(--mrc-tinta)" stroke-width="6" />
      <path d="M36 60 C 42 52 42 68 48 60" stroke="var(--mrc-tinta)" stroke-width="4" stroke-linecap="round" />
      <path d="M192 60 C 198 52 198 68 204 60" stroke="var(--mrc-tinta)" stroke-width="4" stroke-linecap="round" />
      <path d="M70 52 L 66 68 M 110 52 L 106 68 M 150 52 L 146 68" stroke="var(--mrc-tinta)" stroke-width="3" stroke-linecap="round" />
    </g>
    <g transform="rotate(9 120 78)">
      <rect x="52" y="66" width="150" height="24" rx="12"
        fill="var(--mrc-tan-600)" stroke="var(--mrc-tinta)" stroke-width="6" />
      <path d="M58 78 C 63 71 63 85 68 78" stroke="var(--mrc-tinta)" stroke-width="4" stroke-linecap="round" />
      <path d="M186 78 C 191 71 191 85 196 78" stroke="var(--mrc-tinta)" stroke-width="4" stroke-linecap="round" />
      <path d="M96 71 L 93 85 M 132 71 L 129 85 M 164 71 L 161 85" stroke="var(--mrc-tinta)" stroke-width="3" stroke-linecap="round" />
    </g>
  </svg>
</div>

<style>
  .canela { display: block; }
</style>
