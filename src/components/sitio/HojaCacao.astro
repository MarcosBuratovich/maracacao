---
// Hoja de cacao decorativa. Vaivén sobre el nacimiento del tallo (pivote
// real, como la cola de la mascota), spring del token, PRM apaga.
interface Props {
  class?: string
  /** Paso de la rampa verde para variar follaje sin inventar colores. */
  tono?: '400' | '500' | '600'
  /** Retrasa la fase para que dos hojas juntas no se muevan al unísono. */
  tarde?: boolean
}
const { class: clase = '', tono = '500', tarde = false } = Astro.props
---
<div class={`hoja-cacao ${clase}`} data-tarde={tarde} style="aspect-ratio:1" aria-hidden="true">
  <svg viewBox="0 0 200 200" width="100%" height="100%" fill="none">
    <g class="hoja">
      <path d="M100 178 C 100 166 100 160 100 152"
        stroke="var(--mrc-tinta)" stroke-width="6" stroke-linecap="round" />
      <path d="M100 152 C 58 140 48 84 74 48 C 88 28 112 28 126 48 C 152 84 142 140 100 152 Z"
        fill={`var(--mrc-verde-${tono})`} stroke="var(--mrc-tinta)" stroke-width="6" stroke-linejoin="round" />
      <path d="M100 148 C 100 116 100 84 100 52"
        stroke="var(--mrc-tinta)" stroke-width="4" stroke-linecap="round" />
      <g stroke="var(--mrc-tinta)" stroke-width="3" stroke-linecap="round">
        <path d="M100 70 C 110 74 116 80 120 88" />
        <path d="M100 96 C 112 100 118 106 122 114" />
        <path d="M100 122 C 110 126 114 130 118 136" />
        <path d="M100 70 C 90 74 84 80 80 88" />
        <path d="M100 96 C 88 100 82 106 78 114" />
        <path d="M100 122 C 90 126 86 130 82 136" />
      </g>
    </g>
  </svg>
</div>

<style>
  .hoja-cacao { display: block; }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes mecer-hoja {
      0%, 100% { transform: rotate(-4deg); }
      50% { transform: rotate(4deg); }
    }
    .hoja {
      transform-origin: 100px 178px; /* nacimiento del tallo */
      animation: mecer-hoja calc(var(--mrc-dur-ambiental) * 1.25) var(--mrc-ease-spring) infinite;
    }
    [data-tarde='true'] .hoja { animation-delay: calc(var(--mrc-dur-ambiental) / 2); }
  }
</style>
