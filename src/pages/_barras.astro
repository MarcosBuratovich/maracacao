---
// src/pages/barras.astro — El catálogo inmersivo de las 15 barras.
//
// Referencia: bennett-tea.com/tea-store (una pantalla por producto,
// mitad producto sobre color / mitad datos, dots y hash por producto),
// traducida al sistema de marca y a nuestros estándares: scroll-snap de
// CSS en lugar del secuestro de rueda de fullPage (firme en desktop,
// suave en móvil — decisión de Marcos), la tinta medida por sabor en
// vez de blanco fijo, y en las columnas donde la referencia pone notas
// de cata van los datos DUROS de la ficha técnica oficial.
//
// La barra 3D de Marcos vive fija sobre la mitad izquierda y cambia de
// pliego con el sabor activo; sin JS o con reduced-motion, cada
// pantalla muestra su packshot y todo sigue completo.
import Base from '@/layouts/Base.astro'
import selloRaw from '@/assets/brand/sello-mano.svg?raw'
import { marca, precioMXN } from '@/copy/sitio-marca'
import { sabores, urlCatalogoBarras } from '@/copy/sabores'
import { sabor as colorSabor, tintaSabor, marca as paletaMarca } from '@/tokens/color'
import '@/styles/global.css'
import '@/styles/marca.css'

const sello = selloRaw.replace('<svg', '<svg aria-hidden="true" focusable="false"')
const copy = marca.catalogoBarras
const tintaClara = (clave: keyof typeof tintaSabor) => tintaSabor[clave] !== paletaMarca.tintaImpreso
---
<Base titulo={copy.titulo} fuentes="marca" candado>
  <a href="#contenido" class="salto">{marca.skipLink}</a>

  <header class="cinta">
    <a class="cinta-marca" href={copy.rutaVolver} aria-label={copy.volver}>
      <span class="cinta-sello" set:html={sello} />
      <span>
        <span class="cinta-nombre">{marca.marca.wordmark}</span>
        <span class="cinta-volver mono">← {copy.volver}</span>
      </span>
    </a>
    <p class="cinta-titulo mano">{copy.encabezado}</p>
  </header>

  {/* La única instancia 3D, fija sobre la mitad izquierda. */}
  <div
    class="visor-fijo"
    data-catalogo-visor
    data-glb="/sitio/marca/barra.glb"
    data-alt={copy.visorAlt}
  ></div>

  <main id="contenido" class="catalogo" data-catalogo>
    {sabores.map((s) => (
      <section
        id={s.slug}
        class="espectro"
        data-espectro
        data-tono="sabor"
        aria-label={s.nombre}
        style={`--fondo:${colorSabor[s.clave]};--texto:${tintaSabor[s.clave]}`}
      >
        <div class:list={['espectro-visual', tintaClara(s.clave) ? 'sobre-oscuro' : 'sobre-claro']}>
          <img
            src={`/sitio/marca/barra-${s.slug}.webp`}
            alt={`${marca.anaquel.envolturaAltPrefijo} ${s.nombre}`}
            width="754"
            height="1617"
            loading={s.orden === 1 ? 'eager' : 'lazy'}
          />
        </div>
        <div class="espectro-datos">
          <p class="mono espectro-serie">{copy.serie} {s.orden} {copy.de15}</p>
          <h2 class="espectro-nombre">{s.nombre}</h2>
          <div class="espectro-precio-fila">
            <p class="espectro-precio">{precioMXN(s.precio)}</p>
            <span class="espectro-chip mono">{s.cacao}</span>
            <span class="espectro-chip mono">70 g</span>
          </div>
          <div class="espectro-ficha">
            <div class="ficha-col">
              <p class="mano ficha-col-titulo">{copy.colIngredientes}</p>
              <p>{s.ingredientes}.</p>
            </div>
            <div class="ficha-col">
              <p class="mano ficha-col-titulo">{copy.colAlergenos}</p>
              <p>{s.slug === 'blanco-con-pistache' ? copy.alergenosBlanco : copy.alergenos}</p>
            </div>
            <div class="ficha-col">
              <p class="mano ficha-col-titulo">{copy.colConservacion}</p>
              <p>{copy.conservacion} {copy.vida}</p>
            </div>
          </div>
          <div class="espectro-pie">
            <a class="espectro-cta" href={s.catalogo ?? urlCatalogoBarras} target="_blank" rel="noopener">
              {copy.cta}<span class="sr-only"> (se abre en pestaña nueva)</span>
            </a>
            <img
              class="espectro-ilustracion"
              src={`/sitio/marca/ilustracion-${s.slug}.webp`}
              alt=""
              width="400"
              height="500"
              loading="lazy"
            />
          </div>
        </div>
      </section>
    ))}
  </main>

  {/* El selector: las quince miniaturas, siempre a mano. */}
  <nav class="selector" aria-label={copy.selectorAria}>
    {sabores.map((s) => (
      <button
        type="button"
        data-salto={s.slug}
        aria-label={s.nombre}
        aria-current={s.orden === 1 ? 'true' : 'false'}
      >
        <img src={`/sitio/marca/barra-${s.slug}-mini.webp`} alt="" width="380" height="815" loading="lazy" />
      </button>
    ))}
  </nav>

  <script>
    import '@/scripts/marca'
  </script>
</Base>

<style>
  /* ---------- El lienzo: snap firme en desktop, suave en móvil ---------- */
  :global(html) {
    scroll-snap-type: y proximity;
  }
  @media (min-width: 761px) and (prefers-reduced-motion: no-preference) {
    :global(html) { scroll-snap-type: y mandatory; }
  }

  .cinta {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px clamp(16px, 3vw, 32px);
    pointer-events: none;
  }
  .cinta-marca {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--mrc-marca-tinta);
    background: rgb(248 236 222 / 0.92);
    border-radius: 999px;
    padding: 6px 16px 6px 8px;
    box-shadow: 0 4px 14px rgb(31 14 5 / 0.18);
    pointer-events: auto;
  }
  .cinta-sello { display: inline-flex; width: 34px; }
  .cinta-sello :global(svg) { width: 100%; height: auto; }
  .cinta-nombre {
    display: block;
    font-family: var(--mrc-font-titular);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.09em;
    line-height: 1;
  }
  .cinta-volver { display: block; font-size: 0.5625rem; margin-top: 3px; color: var(--mrc-marca-rojoHondo); }
  .cinta-titulo {
    font-size: 1rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    background: rgb(248 236 222 / 0.92);
    color: var(--mrc-marca-tinta);
    border-radius: 999px;
    padding: 8px 18px;
    box-shadow: 0 4px 14px rgb(31 14 5 / 0.18);
    margin: 0;
  }
  @media (max-width: 560px) { .cinta-titulo { display: none; } }

  /* ---------- El visor fijo ---------- */
  .visor-fijo {
    position: fixed;
    left: 0;
    top: 0;
    width: 50vw;
    height: 100svh;
    z-index: 40;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .visor-fijo :global(model-viewer) {
    width: min(34vw, 420px);
    height: min(82svh, 760px);
    pointer-events: auto;
    --poster-color: transparent;
  }
  @media (max-width: 760px) {
    .visor-fijo { width: 100vw; height: 48svh; }
    .visor-fijo :global(model-viewer) { width: min(60vw, 300px); height: 44svh; }
  }

  /* ---------- Las quince pantallas ---------- */
  .espectro {
    min-height: 100svh;
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(16px, 3vw, 48px);
    padding: clamp(64px, 9svh, 90px) clamp(20px, 4vw, 56px) clamp(112px, 16svh, 150px);
    box-sizing: border-box;
  }
  .espectro-visual { display: grid; place-items: center; }
  .espectro-visual img {
    width: clamp(160px, 22vw, 300px);
    height: auto;
    border-radius: 6px;
    transform: rotate(-2deg);
  }
  .sobre-oscuro img { box-shadow: 0 26px 60px rgb(31 14 5 / 0.45); }
  .sobre-claro img { box-shadow: 0 26px 60px rgb(76 44 22 / 0.3); }
  /* Con el 3D andando, los packshots por sección se retiran. */
  :global(html.catalogo-3d) .espectro-visual img { visibility: hidden; }

  .espectro-datos { min-width: 0; max-width: 560px; }
  .espectro-serie { letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.85; margin: 0 0 6px; }
  .espectro-nombre {
    font-family: var(--mrc-font-titular);
    font-weight: 800;
    font-size: clamp(2.25rem, 4.6vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }
  .espectro-precio-fila {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
  }
  .espectro-precio {
    font-family: var(--mrc-font-titular);
    font-weight: 700;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    margin: 0;
  }
  .espectro-chip {
    border: 1.5px solid color-mix(in srgb, var(--texto) 55%, transparent);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 0.6875rem;
  }

  /* Las columnas de la ficha viven en tarjeta clara: texto normal
     SIEMPRE sobre superficie aprobada, pase el sabor que pase. */
  .espectro-ficha {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: clamp(12px, 1.6vw, 22px);
    background: var(--mrc-marca-crema);
    color: var(--mrc-marca-tinta);
    border-radius: 10px;
    box-shadow: 0 18px 40px rgb(31 14 5 / 0.25);
    padding: clamp(16px, 2vw, 24px);
    margin-top: clamp(18px, 2.6svh, 28px);
  }
  .ficha-col-titulo {
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mrc-marca-rojoHondo);
    margin: 0 0 6px;
  }
  .ficha-col p:not(.ficha-col-titulo) {
    font-size: 0.78125rem;
    line-height: 1.55;
    margin: 0;
  }

  .espectro-pie {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-top: clamp(16px, 2.4svh, 24px);
  }
  .espectro-cta {
    font-family: var(--mrc-font-titular);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--texto);
    text-decoration: none;
    border-bottom: 2px solid var(--mrc-marca-amarillo);
    padding-bottom: 2px;
  }
  .espectro-cta:hover { border-bottom-color: var(--texto); }
  .espectro-ilustracion {
    width: clamp(90px, 9vw, 140px);
    height: auto;
    filter: drop-shadow(0 10px 18px rgb(31 14 5 / 0.3));
  }

  @media (max-width: 760px) {
    .espectro {
      grid-template-columns: 1fr;
      align-items: end;
      gap: 0;
      padding-top: 48svh;
      padding-bottom: clamp(88px, 13svh, 120px);
    }
    .espectro-visual {
      position: absolute;
      /* El visual vive en el alto que el visor fijo reserva arriba. */
      inset: 0 0 auto 0;
      height: 48svh;
      align-items: center;
    }
    .espectro { position: relative; }
    .espectro-visual img { width: clamp(120px, 24vh, 190px); }
    .espectro-datos { max-width: none; }
    .espectro-ilustracion { display: none; }
  }

  /* ---------- El selector de sabores ---------- */
  .selector {
    position: fixed;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    z-index: 70;
    display: flex;
    gap: 6px;
    max-width: min(92vw, 720px);
    overflow-x: auto;
    scrollbar-width: none;
    background: rgb(248 236 222 / 0.94);
    border-radius: 999px;
    padding: 8px 12px;
    box-shadow: 0 10px 30px rgb(31 14 5 / 0.28);
  }
  .selector::-webkit-scrollbar { display: none; }
  .selector button {
    flex: none;
    background: none;
    border: none;
    padding: 3px;
    border-radius: 6px;
    cursor: pointer;
    transition: transform 0.2s ease-out;
  }
  .selector button img {
    width: 22px;
    height: auto;
    border-radius: 2px;
    display: block;
  }
  .selector button:hover { transform: translateY(-4px); }
  .selector button[aria-current='true'] {
    box-shadow: 0 0 0 2px var(--mrc-marca-rojo);
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .selector button, .selector button:hover { transition: none; transform: none; }
  }
</style>
