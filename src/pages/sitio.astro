---
// src/pages/sitio.astro — BORRADOR del sitio público, para iterar ideas
// con el cliente. No está enlazado desde la presentación: se comparte por
// URL directa (/sitio). Orden UX del cuestionario; el contenido real sale
// de docs/contenido-sitio.md y lo que falta va marcado con su número de
// pregunta. Reusa las bandas/reveal de landing.css.
import Base from '@/layouts/Base.astro'
import LockupHeader from '@/components/brand/LockupHeader.astro'
import Logotipo from '@/components/brand/Logotipo.astro'
import Banda from '@/components/landing/Banda.astro'
import TabletaSabor from '@/components/landing/TabletaSabor.astro'
import TazaEspuma from '@/components/sitio/TazaEspuma.astro'
import HojaCacao from '@/components/sitio/HojaCacao.astro'
import Mazorca from '@/components/sitio/Mazorca.astro'
import Canela from '@/components/sitio/Canela.astro'
import { sitio } from '@/copy/sitio'
import '@/styles/global.css'
import '@/styles/landing.css'
import '@/styles/sitio.css'
---
<Base titulo={sitio.titulo}>
  {/* Antes del primer paint: el estado oculto del revelado solo existe
      bajo html.js (landing.css) — sin JS la página queda entera. */}
  <script is:inline>document.documentElement.classList.add('js')</script>

  <a href="#contenido" class="salto">{sitio.skipLink}</a>

  <div style="background:var(--mrc-papel)">
    <p class="aviso-borrador">{sitio.aviso}</p>

    <header data-fondo="papel" style="background:var(--b-fondo)">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-6">
        <LockupHeader />
      </div>
    </header>

    <main id="contenido">
      {/* Inicio */}
      <Banda fondo="verde">
        <div class="grid items-center gap-10 md:grid-cols-2">
          <div>
            <h1 class="b-titulo entra">{sitio.inicio.titulo}</h1>
            <p class="b-prosa mt-5 entra entra-2">{sitio.inicio.sub}</p>
            <div class="mt-8 flex flex-wrap gap-4 entra entra-3">
              <a href="#sabores" class="boton boton-amarillo">{sitio.inicio.ctaSabores}</a>
              <a href={sitio.contacto.catalogoUrl} target="_blank" rel="noopener" class="boton boton-fantasma">
                {sitio.inicio.ctaCatalogo}
              </a>
            </div>
          </div>
          <div class="entra entra-2 mx-auto w-full max-w-xs md:max-w-sm">
            <TazaEspuma />
          </div>
        </div>
      </Banda>

      {/* Nuestros productos */}
      <Banda fondo="papel" id="sabores">
        <div class="max-w-2xl" data-revelar>
          <span class="b-overline">{sitio.productos.overline}</span>
          <h2 class="b-titulo mt-3">{sitio.productos.titulo}</h2>
          <p class="mt-4 leading-relaxed">{sitio.productos.intro}</p>
        </div>
        <div class="mt-10 grid gap-10 sm:grid-cols-3" data-revelar class:list="retardo-1">
          {sitio.productos.destacadas.map((s) => (
            <TabletaSabor nombre={s.nombre} tono={s.tono} />
          ))}
        </div>
        <ul class="mt-10 flex flex-wrap gap-2" data-revelar>
          {sitio.productos.barras.map((b) => (
            <li class="sabor-chip">{b}</li>
          ))}
        </ul>
        <div class="mt-8 space-y-2" data-revelar>
          <p class="pendiente-nota"><span class="chip">{sitio.pendiente}</span> {sitio.productos.notaBarras}</p>
          <p class="pendiente-nota"><span class="chip">{sitio.pendiente}</span> {sitio.productos.notaBolsas}</p>
        </div>
      </Banda>

      {/* El ABC del chocolate */}
      <Banda fondo="verde">
        <div class="max-w-2xl" data-revelar>
          <span class="b-overline">{sitio.abc.overline}</span>
          <h2 class="b-titulo mt-3">{sitio.abc.titulo}</h2>
          <p class="mt-4 leading-relaxed">{sitio.abc.intro}</p>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3" data-revelar class:list="retardo-1">
          <div class="tema-card">
            <Mazorca class="h-28 self-start" />
            <h3 class="b-subtitulo">{sitio.abc.temas[0].titulo}</h3>
            <p class="pendiente-nota"><span class="chip">{sitio.pendiente}</span> {sitio.abc.temas[0].nota}</p>
          </div>
          <div class="tema-card">
            <TazaEspuma class="h-28 self-start" />
            <h3 class="b-subtitulo">{sitio.abc.temas[1].titulo}</h3>
            <p class="pendiente-nota"><span class="chip">{sitio.pendiente}</span> {sitio.abc.temas[1].nota}</p>
          </div>
          <div class="tema-card">
            <Canela class="h-24 self-start" />
            <h3 class="b-subtitulo">{sitio.abc.temas[2].titulo}</h3>
            <p class="pendiente-nota"><span class="chip">{sitio.pendiente}</span> {sitio.abc.temas[2].nota}</p>
          </div>
        </div>
      </Banda>

      {/* Recetas */}
      <Banda fondo="papel">
        <div class="grid items-center gap-12 md:grid-cols-2">
          <div data-revelar>
            <span class="b-overline">{sitio.recetas.overline}</span>
            <h2 class="b-titulo mt-3">{sitio.recetas.titulo}</h2>
            <p class="mt-4 leading-relaxed">{sitio.recetas.intro}</p>
            <p class="pendiente-nota mt-6"><span class="chip">{sitio.pendiente}</span> {sitio.recetas.notaRecetas}</p>
          </div>
          <figure class="video-personaje mx-auto w-full max-w-xs" data-revelar class:list="retardo-1">
            <video
              src="/sitio/changuito-molinillo.mp4"
              poster="/sitio/changuito-molinillo-poster.jpg"
              muted
              loop
              playsinline
              autoplay
              preload="metadata"
              aria-label={sitio.recetas.videoAria}
            ></video>
          </figure>
        </div>
      </Banda>

      {/* Quiénes somos */}
      <Banda fondo="verde">
        <div class="grid items-center gap-12 md:grid-cols-[1fr_auto]">
          <div class="max-w-2xl" data-revelar>
            <span class="b-overline">{sitio.quienes.overline}</span>
            <h2 class="b-titulo mt-3">{sitio.quienes.titulo}</h2>
            <p class="b-prosa mt-5">{sitio.quienes.prosa}</p>
            <p class="pendiente-nota mt-6"><span class="chip">{sitio.pendiente}</span> {sitio.quienes.notaHistoria}</p>
          </div>
          {/* Solo el personaje del cliente — la mascota del sistema quedó
              fuera del sitio (decisión de Marcos, 2026-08-10). */}
          <div class="flex items-end justify-center gap-3 sm:gap-4" data-revelar class:list="retardo-1">
            <HojaCacao class="h-16 sm:h-24" tono="400" />
            <img src="/sitio/personaje-sentado.webp" alt={sitio.quienes.imagenAlt}
              class="h-40 w-auto rounded-xl sm:h-56" loading="lazy"
              style="background:var(--mrc-papel)" />
            <HojaCacao class="h-14 sm:h-20" tono="600" tarde />
          </div>
        </div>
      </Banda>

      {/* Para cafeterías y negocios */}
      <Banda fondo="crema">
        <div class="max-w-2xl" data-revelar>
          <span class="b-overline">{sitio.negocios.overline}</span>
          <h2 class="b-titulo mt-3">{sitio.negocios.titulo}</h2>
          <p class="mt-4 leading-relaxed">{sitio.negocios.prosa}</p>
          <div class="mt-6">
            <a href={`mailto:${sitio.contacto.correo}`} class="boton boton-bordo">{sitio.negocios.ctaFichas}</a>
          </div>
          <p class="pendiente-nota mt-6"><span class="chip">{sitio.pendiente}</span> {sitio.negocios.notaFichas}</p>
        </div>
      </Banda>

      {/* Preguntas frecuentes */}
      <Banda fondo="papel">
        <div class="max-w-2xl" data-revelar>
          <span class="b-overline">{sitio.faq.overline}</span>
          <h2 class="b-titulo mt-3">{sitio.faq.titulo}</h2>
          <ul class="mt-6 space-y-3">
            {sitio.faq.ejemplos.map((e) => (
              <li class="rounded-lg p-4 font-semibold" style="background:var(--mrc-crema);color:var(--mrc-verde-700)">
                {e}
              </li>
            ))}
          </ul>
          <p class="pendiente-nota mt-6"><span class="chip">{sitio.pendiente}</span> {sitio.faq.nota}</p>
        </div>
      </Banda>

      {/* Contacto */}
      <Banda fondo="profundo">
        <div class="text-center" data-revelar>
          <span class="b-overline">{sitio.contacto.overline}</span>
          <h2 class="b-titulo mt-3">{sitio.contacto.titulo}</h2>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a href={`mailto:${sitio.contacto.correo}`} class="boton boton-amarillo">{sitio.contacto.correo}</a>
            <a href={sitio.contacto.catalogoUrl} target="_blank" rel="noopener" class="boton boton-fantasma">
              {sitio.contacto.catalogoNombre}
            </a>
          </div>
          <p class="pendiente-nota mt-8 justify-center"><span class="chip">{sitio.pendiente}</span> {sitio.contacto.notaContacto}</p>
        </div>
      </Banda>
    </main>

    <footer>
      <Banda fondo="profundo">
        <div class="flex flex-col items-center gap-3 text-center" style="border-top:1px solid var(--mrc-verde-700);padding-top:2rem">
          <Logotipo alto={24} />
          <p class="b-menor">{sitio.footer.leyenda}</p>
          <p class="b-menor" style="color:var(--mrc-crema)">{sitio.footer.nota}</p>
        </div>
      </Banda>
    </footer>
  </div>
</Base>

<script>
  import '@/scripts/revelar'

  // El video del personaje respeta reduced-motion: quieto y con controles.
  const video = document.querySelector('.video-personaje video')
  if (video instanceof HTMLVideoElement && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.autoplay = false
    video.controls = true
    video.pause()
  }
</script>
