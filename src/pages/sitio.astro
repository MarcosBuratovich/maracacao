    background: var(--mrc-marca-tinta);
    transition: transform 0.3s ease-out, opacity 0.2s ease-out;
  }
  .hamburguesa[aria-expanded='true'] .hamburguesa-linea:nth-child(2) { transform: translateY(7.5px) rotate(45deg); }
  .hamburguesa[aria-expanded='true'] .hamburguesa-linea:nth-child(3) { opacity: 0; }
  .hamburguesa[aria-expanded='true'] .hamburguesa-linea:nth-child(4) { transform: translateY(-7.5px) rotate(-45deg); }

  /* Con el menú abierto la cabecera flota sobre el overlay oscuro. */
