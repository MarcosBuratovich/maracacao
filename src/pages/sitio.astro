  .panel[hidden] { display: none; }
  .panel-lista { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .panel-lista li { display: flex; gap: 10px; align-items: baseline; font-size: 0.9375rem; }
