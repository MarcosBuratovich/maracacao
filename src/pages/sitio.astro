    margin: 0;
  }
  .portada-tira { margin: clamp(12px, 2vw, 24px) -14px 0; will-change: transform; }
  /* El aire vertical vive DENTRO de la marquesina (que recorta): sin él,
     la rotación y las sombras de las barras se decapitan abajo. */
  .portada-tira :global(.marquesina) { padding-block: clamp(28px, 3vw, 46px); }
  .tira-barra {
    width: clamp(132px, 14vw, 196px);
    height: auto;
    border-radius: 4px;
    box-shadow: 0 12px 26px rgb(76 44 22 / 0.32);
    transition: transform 0.25s ease-out;
  }
  .tira-barra:hover { transform: scale(1.05) rotate(2deg); }

  /* ---------- Qué hay en una barra ---------- */
  .postura {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(20px, 3.5vw, 48px);
