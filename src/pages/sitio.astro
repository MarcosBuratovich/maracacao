  :global(html.menu-abierto) .hamburguesa-linea { background: var(--mrc-marca-crema); }

  /* Sin JS: fila simple de enlaces. Con JS: overlay a pantalla completa. */
  .menu { border-bottom: 1px solid rgb(76 44 22 / 0.25); background: var(--mrc-marca-bandaCalida); }
  .menu-interior { max-width: 1100px; margin-inline: auto; padding: 10px clamp(20px, 5vw, 56px); }
  .menu-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }
