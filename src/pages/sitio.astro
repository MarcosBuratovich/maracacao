---
// src/pages/sitio.astro — El sitio público de Maracacao.
//
// Sistema: `src/styles/editorial.css`. Canon de Van de Graaf a nueve
// columnas (bloque de texto en 2/8, notas al margen en 8/10), una sola
// tinta sobre un solo papel, y el color puesto por el producto: los
// tonos de las etiquetas son índice de sabor, nunca fondo de sección.
//
// El sello es la firma de la página: se estampa al cargar, el wordmark
// abre su tracking en la tipografía del propio logotipo (Cormorant
// Garamond, comparada contra el logo real), y al salir del hero el
// sello se acopla a la barra.
import Base from '@/layouts/Base.astro'
import selloRaw from '@/assets/brand/sello-mano.svg?raw'
import { sitio, precioMXN } from '@/copy/sitio'
import '@/styles/global.css'
import '@/styles/editorial.css'

const sello = selloRaw.replace('<svg', '<svg aria-hidden="true" focusable="false"')

const nav = [
  ['#productos', sitio.nav.productos],
  ['#abc', sitio.nav.abc],
  ['#recetas', sitio.nav.recetas],
  ['#quienes', sitio.nav.quienes],
  ['#negocios', sitio.nav.negocios],
  ['#contacto', sitio.nav.contacto],
] as const

// La tira del hero se duplica para que el bucle no tenga costura.
const tira = [...sitio.hero.tira, ...sitio.hero.tira]
---
<Base titulo={sitio.titulo} fuentes="sitio">
  <a href="#contenido" class="salto">{sitio.skipLink}</a>

  <div class="ed" data-tono="papel">
    <header class="barra">
      <a class="barra-marca" href="#contenido" aria-label={sitio.marca.nombre}>
        <span class="barra-sello sello" set:html={sello} />
        <span class="wordmark barra-nombre">{sitio.marca.wordmark}</span>
      </a>
      <nav class="barra-nav" aria-label="Secciones">
        {nav.map(([href, etiqueta]) => <a href={href}>{etiqueta}</a>)}
      </nav>
    </header>

    <main id="contenido">
      {/* ——— El sello ——— */}
      <section class="seccion hero" data-tono="tinta">
        <div class="registro registro-simetrico"><span></span><span></span></div>
        {/* Fuera del canon a propósito: el wordmark es la pieza que se
            come el ancho completo, de margen a margen. */}
        <div class="hero-centro">
          <div class="hero-sello sello estampa" set:html={sello} />
          <h1 class="monumento abre">{sitio.marca.wordmark}</h1>
          <p class="marca hero-descriptor entra-suave" style="--retardo:900ms">
            {sitio.marca.descriptor}
          </p>
          <hr class="regla hero-regla entra-suave" style="--retardo:1050ms" />
          <ul class="hero-meta marca entra-suave" style="--retardo:1150ms">
            <li>{sitio.hero.lugar}</li>
            <li>{sitio.hero.cacao}</li>
            <li>{sitio.hero.hecho}</li>
          </ul>
        </div>

        {/* El producto real llenando el pie del hero: las barras del
            catálogo, en marcha lenta. */}
        <div class="hero-tira entra-suave" style="--retardo:1400ms" role="img" aria-label={sitio.hero.tiraAria}>
          <div class="hero-pista">
            {tira.map((p) => (
              <img
                src={`/sitio/catalogo/${p.archivo}.webp`}
                alt="" aria-hidden="true" loading="lazy"
                width="450" height="600"
              />
            ))}
          </div>
        </div>
        <span data-centinela></span>
      </section>

      {/* ——— Manifiesto ——— */}
      <section class="seccion" data-tono="papel">
        <div class="canon aire">
          <div class="bloque">
            <p class="marca" data-revelar>{sitio.manifiesto.marca}</p>
            <h2 class="display manifiesto-frase" data-lineas data-revelar>{sitio.manifiesto.frase}</h2>
            <p class="cuerpo manifiesto-cuerpo" data-revelar style="--retardo:180ms">{sitio.manifiesto.cuerpo}</p>
          </div>
          <aside class="margen nota-margen" data-revelar style="--retardo:260ms">
            {sitio.manifiesto.notaMargen.map((n) => <div>{n}</div>)}
          </aside>
        </div>
      </section>

      {/* ——— Productos ——— */}
      <section class="seccion" data-tono="papel" id="productos">
        <div class="canon">
          <div class="bloque">
            <h2 class="display" data-lineas data-revelar>{sitio.productos.titulo}</h2>
            <p class="cuerpo tenue prod-intro" data-revelar style="--retardo:150ms">{sitio.productos.intro}</p>
          </div>
          <aside class="margen nota-margen" data-revelar style="--retardo:220ms">
            {sitio.productos.notaMargen.map((n) => <div>{n}</div>)}
          </aside>

          <div class="simetrico prod-lineas" data-revelar>
            {sitio.productos.lineas.map((l) => (
              <article class="ficha pieza">
                <div class="arco ficha-arco" data-campo={l.campo}>
                  <img
                    src={`/sitio/catalogo/${l.imagen}.webp`}
                    alt={l.imagenAlt}
                    loading="lazy" width="480" height="640"
                  />
                </div>
                <h3 class="sub ficha-nombre">{l.nombre}</h3>
                <p class="marca ficha-pres">{l.presentacion}</p>
                {'precioDesde' in l && l.precioDesde && (
                  <p class="ficha-precio">{precioMXN(l.precioDesde)}</p>
                )}
                <ul class="lista-limpia">
                  {l.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>

        {/* Las barras al frente: imagen de producto reconstruida, con
            alfa, flotando sobre su campo de color. */}
        <div class="canon aire-corto">
          <div class="bloque">
            <h3 class="titulo" data-revelar>{sitio.productos.destacadas.titulo}</h3>
            <p class="cuerpo tenue destacadas-intro" data-revelar style="--retardo:120ms">
              {sitio.productos.destacadas.intro}
            </p>
          </div>
          <div class="simetrico destacadas" data-revelar style="--retardo:180ms">
            {sitio.productos.destacadas.items.map((b) => (
              <article class="pieza destacada">
                <div class="arco destacada-arco" data-campo={b.campo}>
                  <img src={`/sitio/packshot/${b.archivo}.webp`} alt={b.alt} loading="lazy" width="470" height="992" />
                </div>
                <div class="destacada-pie">
                  <div>
                    <h4 class="sub">{b.nombre}</h4>
                    <p class="marca destacada-cacao">{b.cacao} · 70 g</p>
                  </div>
                  <span class="ficha-precio">{precioMXN(b.precio)}</span>
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="canon prod-fotos">
          {sitio.productos.fotos.map((f, i) => (
            <figure class={`foto-${i + 1}`}>
              <div class="marco-foto">
                <img src={`/sitio/${f.archivo}.webp`} alt={f.alt} loading="lazy" width="883" height="1100" />
              </div>
              <figcaption class="foto-pie">
                <span class="marca">{f.nombre}</span>
                <span class="ficha-precio">{precioMXN(f.precio)}</span>
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="canon aire-corto">
          <div class="bloque indice-cabeza">
            <h3 class="titulo" data-revelar>{sitio.productos.indiceTitulo}</h3>
          </div>
          <p class="margen nota-margen" data-revelar>{sitio.productos.barras.length}</p>
        </div>
        <div class="cinta-marco">
          <div class="cinta">
            {[0, 1].map(() =>
              sitio.productos.barras.map((s) => (
                <span class="sabor" style={`--tono:var(--mrc-etiqueta-${s.tono})`}>{s.nombre}</span>
              )),
            )}
          </div>
        </div>
        <div class="canon aire-corto">
          <p class="bloque menor tenue">{sitio.productos.indiceNota}</p>
        </div>
      </section>

      {/* ——— Chocolate en polvo: el color, contenido ——— */}
      <section class="seccion" data-tono="tinta">
        <div class="canon aire">
          <div class="bloque">
            <p class="chip-pronto" data-revelar>{sitio.polvo.nota}</p>
            <h2 class="display" data-lineas data-revelar>{sitio.polvo.titulo}</h2>
            <p class="cuerpo tenue polvo-intro" data-revelar style="--retardo:150ms">{sitio.polvo.intro}</p>
          </div>
          <div class="pleno polvo-grilla" data-revelar style="--retardo:220ms">
            {sitio.polvo.sabores.map((s) => (
              <figure class="pieza">
                <div class="arco polvo-arco" data-campo={s.campo}>
                  <img
                    src={`/sitio/${s.archivo}.webp`}
                    alt={`${sitio.polvo.altPrefijo} ${s.nombre}`}
                    loading="lazy" width="468" height="900"
                  />
                </div>
                <figcaption class="marca polvo-pie">{s.nombre}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      {/* ——— El ABC ——— */}
      <section class="seccion" data-tono="papel" id="abc">
        <div class="canon aire">
          <div class="bloque">
            <h2 class="display" data-lineas data-revelar>{sitio.abc.titulo}</h2>
            <p class="cuerpo tenue abc-intro" data-revelar style="--retardo:150ms">{sitio.abc.intro}</p>
          </div>
          <aside class="margen nota-margen" data-revelar style="--retardo:220ms">
            {sitio.abc.notaMargen.map((n) => <div>{n}</div>)}
          </aside>

          <div class="mitad-i abc-textos" data-revelar>
            {sitio.abc.bloques.map((b) => (
              <article class="abc-bloque">
                <h3 class="sub">{b.titulo}</h3>
                <p class="cuerpo">{b.cuerpo}</p>
              </article>
            ))}
          </div>

          <div class="mitad-d abc-cata" data-revelar style="--retardo:180ms">
            <h3 class="titulo abc-cata-titulo">{sitio.abc.catar.titulo}</h3>
            <ol class="lista-limpia">
              {sitio.abc.catar.pasos.map((p, i) => (
                <li class="paso">
                  <span class="paso-n">{String(i + 1).padStart(2, '0')}</span>
                  <span>
                    <span class="sub paso-nombre">{p.nombre}</span>
                    <span class="menor tenue paso-texto">{p.texto}</span>
                  </span>
                </li>
              ))}
            </ol>
          </div>

          <blockquote class="simetrico cita" data-revelar>
            <p class="display cita-texto">{sitio.abc.cita}</p>
          </blockquote>
        </div>
      </section>

      {/* ——— Recetas ——— */}
      <section class="seccion" data-tono="hueso" id="recetas">
        <div class="canon aire">
          <div class="recetas-cabeza">
            <h2 class="display" data-lineas data-revelar>{sitio.recetas.titulo}</h2>
            <p class="cuerpo tenue recetas-intro" data-revelar style="--retardo:150ms">{sitio.recetas.intro}</p>
          </div>
          <figure class="recetas-personaje" data-revelar style="--retardo:220ms">
            <img
              src="/sitio/personaje-molinillo-t.webp"
              alt={sitio.recetas.imagenAlt}
              loading="lazy" width="460" height="814"
            />
          </figure>
          <div class="recetas-grilla" data-revelar>
            {sitio.recetas.lista.map((r) => (
              <article class="receta">
                <h3 class="titulo receta-titulo">{r.titulo}</h3>
                <p class="marca receta-porcion">{r.porcion}</p>
                <ul class="lista-limpia">
                  {r.ingredientes.map((i) => <li>{i}</li>)}
                </ul>
                <p class="cuerpo receta-pasos">{r.pasos}</p>
                <p class="menor receta-tip">
                  <span class="marca receta-tip-etiqueta">{sitio.recetas.etiquetaTip}</span>
                  {r.tip}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      {/* ——— Quiénes somos ——— */}
      <section class="seccion" data-tono="tinta" id="quienes">
        <div class="canon aire">
          <div class="quienes-texto">
            <p class="marca" data-revelar>{sitio.quienes.titulo}</p>
            <h2 class="display quienes-frase" data-lineas data-revelar>{sitio.quienes.frase}</h2>
            <p class="cuerpo quienes-cuerpo" data-revelar style="--retardo:180ms">{sitio.quienes.prosa}</p>
            <p class="cuerpo tenue" data-revelar style="--retardo:240ms">{sitio.quienes.origen}</p>
          </div>
          <aside class="quienes-margen" data-revelar style="--retardo:300ms">
            <img
              src="/sitio/personaje-sentado-t.webp"
              alt={sitio.quienes.imagenAlt}
              loading="lazy" width="560" height="991"
            />
            <div class="nota-margen">
              {sitio.quienes.notaMargen.map((n) => <div>{n}</div>)}
            </div>
          </aside>
        </div>
      </section>

      {/* ——— Negocios ——— */}
      <section class="seccion" data-tono="papel" id="negocios">
        <div class="canon aire">
          <div class="bloque">
            <h2 class="display" data-lineas data-revelar>{sitio.negocios.titulo}</h2>
            <p class="cuerpo negocios-prosa" data-revelar style="--retardo:150ms">{sitio.negocios.prosa}</p>
            <ul class="negocios-datos marca" data-revelar style="--retardo:200ms">
              {sitio.negocios.fichasDatos.map((d) => <li>{d}</li>)}
            </ul>
            <p class="negocios-cta" data-revelar style="--retardo:260ms">
              <a class="cta" href={`mailto:${sitio.contacto.correo}`} data-cursor={sitio.cursor.escribir} data-iman>
                <span class="cta-txt"><span>{sitio.negocios.ctaFichas}</span><span>{sitio.negocios.ctaFichas}</span></span>
                <span class="cta-flecha" aria-hidden="true">→</span>
              </a>
            </p>
          </div>
        </div>
      </section>

      {/* ——— Preguntas frecuentes ——— */}
      <section class="seccion" data-tono="hueso">
        <div class="canon aire">
          <div class="bloque">
            <h2 class="display faq-titulo" data-lineas data-revelar>{sitio.faq.titulo}</h2>
            <div data-revelar style="--retardo:150ms">
              {sitio.faq.items.map((item) => (
                <details class="faq">
                  <summary>{item.p}</summary>
                  <p>{item.r}</p>
                </details>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* ——— Contacto ——— */}
      <section class="seccion" data-tono="tinta" id="contacto">
        <div class="registro"><span></span><span></span></div>
        <div class="canon aire contacto-canon">
          <div class="simetrico contacto-centro">
            <p class="marca" data-revelar>{sitio.contacto.titulo}</p>
            <p class="display contacto-invitacion" data-lineas data-revelar>{sitio.contacto.invitacion}</p>
            <a
              class="wordmark contacto-correo"
              href={`mailto:${sitio.contacto.correo}`}
              data-cursor={sitio.cursor.escribir}
              data-revelar style="--retardo:200ms"
            >{sitio.contacto.correo}</a>

            <div class="contacto-datos" data-revelar style="--retardo:280ms">
              <div>
                <p class="marca">{sitio.contacto.puntoVentaEtiqueta}</p>
                <p class="menor contacto-dato">{sitio.contacto.puntoVenta}</p>
              </div>
              <div>
                <p class="marca">{sitio.contacto.catalogoEtiqueta}</p>
                <p class="contacto-dato">
                  <a
                    class="cta cta-contacto"
                    href={sitio.contacto.catalogoUrl}
                    target="_blank" rel="noopener"
                    data-cursor={sitio.cursor.abrir} data-iman
                  >
                    <span class="cta-txt"><span>{sitio.contacto.catalogoNombre}</span><span>{sitio.contacto.catalogoNombre}</span></span>
                    <span class="cta-flecha" aria-hidden="true">↗</span>
                  </a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="seccion" data-tono="tinta">
      <div class="canon pie">
        <div class="pleno pie-fila">
          <span class="sello pie-sello" set:html={sello} />
          <span class="marca">{sitio.footer.derechos}</span>
          <span class="marca">{sitio.footer.lugar}</span>
        </div>
      </div>
    </footer>
  </div>
</Base>

<style>
  /* ——— Hero ——— */
  .hero {
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: center;
    position: relative;
    overflow: hidden; /* el wordmark respira al borde, nunca desborda la página */
  }
  .hero-centro { padding-top: clamp(4rem, 9vh, 7rem); }

  /* Tira de producto: fotos reales del catálogo, a paso lento. */
  .hero-tira {
    overflow: hidden;
    padding-bottom: clamp(1.5rem, 4vh, 3rem);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .hero-pista {
    display: flex;
    gap: clamp(0.75rem, 1.4vw, 1.5rem);
    width: max-content;
  }
  .hero-pista img {
    display: block;
    width: clamp(6.5rem, 10vw, 11rem);
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 2px;
    border: 1px solid var(--linea);
  }
  /* El centinela avisa cuándo el sello sale de pantalla; fuera de flujo
     para no abrir una segunda fila en la grilla del hero. */
  .hero > [data-centinela] { position: absolute; inset: auto 0 0 0; height: 1px; }
  .hero-centro { text-align: center; }
  /* El padding va SOLO en los bloques de texto: aplicárselo al sello,
     que tiene ancho fijo y box-sizing border-box, lo colapsaba a cero
     (visto en vivo: el sello desaparecía). */
  .hero-centro > :is(.hero-descriptor, .hero-meta) {
    padding-inline: clamp(1.25rem, 5.5vw, 5.5rem);
  }
  .hero-sello {
    width: clamp(5.5rem, 11vw, 10rem);
    margin: 0 auto clamp(1.75rem, 4vh, 3rem);
  }
  .hero-regla { margin-inline: auto; }
  .hero-descriptor { margin-top: clamp(1rem, 2.5vh, 1.75rem); letter-spacing: 0.42em; }
  .hero-regla { width: min(85%, 34rem); margin: clamp(1.75rem, 4vh, 2.75rem) auto 0; }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem clamp(1.5rem, 4vw, 3.5rem);
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  /* ——— Manifiesto ——— */
  .manifiesto-frase { margin-top: 1.25rem; }
  .manifiesto-cuerpo { margin-top: clamp(1.75rem, 3vw, 2.5rem); }

  /* ——— Productos ——— */
  .prod-intro { margin-top: 1.25rem; }
  .prod-lineas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(1.75rem, 3vw, 3rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  /* El arco necesita aire arriba: el producto se sale por el borde
     superior y la sombra dura cae a la izquierda. */
  .ficha-arco { aspect-ratio: 3 / 4; margin: 2.5rem 0.4rem 1.5rem 0.5rem; }
  .ficha-nombre { margin-top: 0; }
  .ficha-pres { margin-top: 0.5rem; }
  .ficha-precio { margin-top: 0.75rem; display: block; }
  .prod-lineas .lista-limpia { margin-top: 1.25rem; }

  /* Barras destacadas: el packshot tiene alfa, así que flota sobre el
     campo en vez de ser un recuadro de foto. */
  .destacadas-intro { margin-top: 1rem; }
  .destacadas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .destacada { margin: 0; }
  /* Proporciones calculadas para que la barra rompa el arco SOLO por
     arriba y su base quede adentro: la barra mide 0.474 de ancho/alto,
     así que a 58% del arco su alto es 1.224 del ancho del arco. */
  .destacada-arco { aspect-ratio: 4 / 4.9; margin: 3.5rem 0.5rem 1.5rem 0.6rem; }
  .destacada-arco img { width: 58%; translate: 0 -10%; rotate: -5deg; }
  .destacada-pie {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--linea);
    padding-top: 1rem;
  }
  .destacada-cacao { margin-top: 0.35rem; }
  .destacada-pie .ficha-precio { margin: 0; }

  .prod-fotos { margin-top: clamp(3.5rem, 8vw, 7rem); align-items: start; }
  .prod-fotos figure { margin: 0; }
  .foto-1 { grid-column: 1 / 5; }
  .foto-2 { grid-column: 5 / 8; margin-top: clamp(2rem, 8vw, 7rem); }
  .foto-3 { grid-column: 8 / 10; margin-top: clamp(1rem, 4vw, 3rem); }
  .foto-1 .marco-foto { aspect-ratio: 4 / 5; }
  .foto-2 .marco-foto { aspect-ratio: 3 / 4; }
  .foto-3 .marco-foto { aspect-ratio: 1 / 1; }
  .foto-pie {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--linea);
    margin-top: 0.85rem;
  }
  .foto-pie .ficha-precio { font-size: 1.15rem; margin: 0; }

  /* ——— Polvo ——— */
  .polvo-intro { margin-top: 1.25rem; }
  .polvo-grilla {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    /* Un punto más chica que las barras: es la línea que todavía no se
       vende y no puede gritar más que el producto del mostrador. */
    max-width: 62rem;
