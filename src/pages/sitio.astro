---
// src/pages/sitio.astro — El sitio público de Maracacao, en alta
// fidelidad. Centro de información concreto: títulos directos, sin
// juegos de palabras (retro 2026-08-12). Todo el contenido es real
// (docs/contenido-sitio.md + docs/respuestas-formulario.md); los assets
// del cliente van sin fondo (public/sitio/*-t.*). El logo transparente
// SOLO vive sobre banda clara; sobre bandas oscuras iría la tarjeta.
import Base from '@/layouts/Base.astro'
import Banda from '@/components/landing/Banda.astro'
import TabletaSabor from '@/components/landing/TabletaSabor.astro'
import TazaEspuma from '@/components/sitio/TazaEspuma.astro'
import HojaCacao from '@/components/sitio/HojaCacao.astro'
import Mazorca from '@/components/sitio/Mazorca.astro'
import Canela from '@/components/sitio/Canela.astro'
import { sitio, precioMXN } from '@/copy/sitio'
import '@/styles/global.css'
import '@/styles/landing.css'
import '@/styles/sitio.css'

const nav = [
  ['#productos', sitio.nav.productos],
  ['#abc', sitio.nav.abc],
  ['#recetas', sitio.nav.recetas],
  ['#quienes', sitio.nav.quienes],
  ['#negocios', sitio.nav.negocios],
  ['#faq', sitio.nav.faq],
  ['#contacto', sitio.nav.contacto],
] as const

// Minis flotando en el hero, colores medidos del empaque.
const minis = [
  { cuerpo: 'morado', tam: 4.4, top: 8, left: 74, rot: -11, fase: 0 },
  { cuerpo: 'naranja', tam: 3.4, top: 64, left: 68, rot: 9, fase: 0.4 },
  { cuerpo: 'menta', tam: 3.8, top: 26, left: 92, rot: 13, fase: 0.7 },
] as const
---
<Base titulo={sitio.titulo}>
  <script is:inline>document.documentElement.classList.add('js')</script>

  <a href="#contenido" class="salto">{sitio.skipLink}</a>

  <div style="background:var(--mrc-papel)" data-fondo="papel">
    <header class="sitio-header">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-3">
        <img src="/sitio/logo-t.png" alt={sitio.construccion.logoAlt} class="h-16 w-auto sm:h-20" width="560" height="560" />
        <nav class="sitio-nav flex flex-wrap items-center gap-x-5 gap-y-1" aria-label="Secciones">
          {nav.map(([href, etiqueta]) => <a href={href}>{etiqueta}</a>)}
        </nav>
      </div>
    </header>

    <main id="contenido">
      {/* Hero */}
      <Banda fondo="verde">
        <div class="relative grid items-center gap-10 md:grid-cols-[3fr_2fr]">
          {minis.map((m) => (
            <div
              class="mini-flota"
              style={`--cuerpo:var(--mrc-empaque-${m.cuerpo});--tam:${m.tam}rem;--rot:${m.rot}deg;--fase:${m.fase};top:${m.top}%;left:${m.left}%`}
              aria-hidden="true"
            />
          ))}
          <div>
            <h1 class="b-titulo entra">{sitio.hero.titulo}</h1>
            <p class="b-prosa mt-5 entra entra-2">{sitio.hero.sub}</p>
            <div class="mt-8 flex flex-wrap gap-4 entra entra-3">
              <a href="#productos" class="boton boton-amarillo">{sitio.hero.ctaSabores}</a>
              <a href={sitio.contacto.catalogoUrl} target="_blank" rel="noopener" class="boton boton-fantasma">
                {sitio.hero.ctaCatalogo}
              </a>
            </div>
          </div>
          <img
            src="/sitio/personaje-molinillo-t.webp"
            alt={sitio.hero.imagenAlt}
            class="entra entra-2 relative mx-auto w-56 max-w-full sm:w-72"
            width="560" height="991"
          />
        </div>
      </Banda>

      {/* Nuestros productos */}
      <Banda fondo="papel" id="productos">
        <div class="max-w-2xl" data-revelar>
          <h2 class="b-titulo">{sitio.productos.titulo}</h2>
          <p class="mt-4 leading-relaxed">{sitio.productos.intro}</p>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-3" data-revelar class:list="retardo-1">
          {sitio.productos.lineas.map((l) => (
            <article class="linea-card">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="b-subtitulo">{l.nombre}</h3>
                {'precioDesde' in l && l.precioDesde && (
                  <span class="chip-precio">{precioMXN(l.precioDesde)}</span>
                )}
              </div>
              <p class="b-menor b-sec">{l.presentacion}</p>
              <ul>
                {l.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </article>
          ))}
        </div>

        <div class="mt-14 grid gap-10 sm:grid-cols-3" data-revelar>
          {sitio.productos.destacadas.map((s) => (
            <TabletaSabor nombre={s.nombre} tono={s.tono} precioTexto={precioMXN(s.precio)} />
          ))}
        </div>

        <h3 class="b-subtitulo mt-14" data-revelar>{sitio.productos.saboresTitulo}</h3>
        <ul class="mt-4 flex flex-wrap gap-2" data-revelar>
          {sitio.productos.barras.map((b) => (
            <li class="sabor-chip">{b}</li>
          ))}
        </ul>
        <p class="b-menor b-sec mt-6" data-revelar>
          {sitio.productos.notaMinis} <span class="chip-precio">{precioMXN(sitio.productos.precioMinis)}</span>
        </p>
        <p class="mt-10 font-semibold" style="color:var(--mrc-bordo)" data-revelar>{sitio.productos.tagline}</p>
      </Banda>

      {/* El ABC del chocolate */}
      <Banda fondo="verde" id="abc">
        <div class="max-w-2xl" data-revelar>
          <h2 class="b-titulo">{sitio.abc.titulo}</h2>
          <p class="mt-4 leading-relaxed">{sitio.abc.intro}</p>
        </div>

        <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_1.2fr]">
          <div class="flex flex-col gap-6" data-revelar>
            <article class="abc-bloque">
              <h3 class="b-subtitulo">{sitio.abc.porcentaje.titulo}</h3>
              <p class="b-menor mt-3 leading-relaxed">{sitio.abc.porcentaje.cuerpo}</p>
            </article>
            <article class="abc-bloque">
              <h3 class="b-subtitulo">{sitio.abc.aditivos.titulo}</h3>
              <p class="b-menor mt-3 leading-relaxed">{sitio.abc.aditivos.cuerpo}</p>
            </article>
            <article class="abc-bloque">
              <h3 class="b-subtitulo">{sitio.abc.beneficios.titulo}</h3>
              <p class="b-menor mt-3 leading-relaxed">{sitio.abc.beneficios.cuerpo}</p>
            </article>
          </div>

          <div class="abc-bloque" data-revelar class:list="retardo-1">
            <div class="flex items-start justify-between gap-4">
              <h3 class="b-subtitulo">{sitio.abc.catar.titulo}</h3>
              <TazaEspuma class="h-20 shrink-0" />
            </div>
            <ol class="mt-6 flex flex-col gap-5">
              {sitio.abc.catar.pasos.map((p, i) => (
                <li class="paso">
                  <span class="paso-numero">{i + 1}</span>
                  <div>
                    <p class="paso-nombre">{p.nombre}</p>
                    <p class="paso-texto mt-1">{p.texto}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <p class="b-prosa mx-auto mt-12 text-center" style="font-family:var(--mrc-font-display);color:var(--mrc-crema)" data-revelar>
          {sitio.abc.cita}
        </p>
      </Banda>

      {/* Recetas */}
      <Banda fondo="papel" id="recetas">
        <div class="grid items-start gap-10 md:grid-cols-[2fr_1fr]">
          <div data-revelar>
            <h2 class="b-titulo">{sitio.recetas.titulo}</h2>
            <p class="mt-4 max-w-2xl leading-relaxed">{sitio.recetas.intro}</p>
          </div>
          <figure class="video-personaje mx-auto w-full max-w-52" data-revelar class:list="retardo-1">
            <video
              src="/sitio/changuito-molinillo.mp4"
              poster="/sitio/changuito-molinillo-poster.jpg"
              muted
              loop
              playsinline
              autoplay
              preload="metadata"
              aria-label={sitio.recetas.videoAria}
            ></video>
          </figure>
        </div>
        <div class="mt-10 grid gap-6 sm:grid-cols-2" data-revelar>
          {sitio.recetas.lista.map((r) => (
            <article class="receta-card">
              <h3 class="b-subtitulo">{r.titulo}</h3>
              <p class="b-menor b-sec mt-1">{r.porcion}</p>
              <ul class="mt-4 list-disc space-y-1 pl-5">
                {r.ingredientes.map((i) => <li>{i}</li>)}
              </ul>
              <p class="mt-4 leading-relaxed">{r.pasos}</p>
              <p class="b-menor mt-3 font-semibold" style="color:var(--mrc-bordo)">
                {sitio.recetas.etiquetaTip} {r.tip}
              </p>
            </article>
          ))}
        </div>
      </Banda>

      {/* Quiénes somos */}
      <Banda fondo="verde" id="quienes">
        <div class="grid items-center gap-12 md:grid-cols-[1fr_auto]">
          <div class="max-w-2xl" data-revelar>
            <h2 class="b-titulo">{sitio.quienes.titulo}</h2>
            <p class="b-prosa mt-5">{sitio.quienes.prosa}</p>
            <p class="b-prosa mt-4">{sitio.quienes.origen}</p>
          </div>
          <div class="flex items-end justify-center gap-3 sm:gap-4" data-revelar class:list="retardo-1">
            <HojaCacao class="h-16 sm:h-24" tono="400" />
            <img
              src="/sitio/personaje-sentado-t.webp"
              alt={sitio.quienes.imagenAlt}
              class="h-40 w-auto sm:h-56"
              width="560" height="991"
              loading="lazy"
            />
            <HojaCacao class="h-14 sm:h-20" tono="600" tarde />
          </div>
        </div>
      </Banda>

      {/* Para cafeterías y negocios */}
      <Banda fondo="crema" id="negocios">
        <div class="grid items-center gap-10 md:grid-cols-[2fr_1fr]">
          <div data-revelar>
            <h2 class="b-titulo">{sitio.negocios.titulo}</h2>
            <p class="mt-4 max-w-2xl leading-relaxed">{sitio.negocios.prosa}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {sitio.negocios.fichasDatos.map((d) => (
                <li class="b-menor rounded-full border-2 px-3 py-1 font-semibold" style="border-color:var(--mrc-verde-200);color:var(--mrc-verde-600)">
                  {d}
                </li>
              ))}
            </ul>
            <div class="mt-8">
              <a href={`mailto:${sitio.contacto.correo}`} class="boton boton-bordo">{sitio.negocios.ctaFichas}</a>
            </div>
          </div>
          <div class="mx-auto flex items-end gap-6" data-revelar class:list="retardo-1">
            <Mazorca class="h-32" tono="bordo" />
            <Canela class="h-20" />
          </div>
        </div>
      </Banda>

      {/* Preguntas frecuentes */}
      <Banda fondo="papel" id="faq" angosta>
        <div data-revelar>
          <h2 class="b-titulo">{sitio.faq.titulo}</h2>
          <p class="mt-3 leading-relaxed b-sec">{sitio.faq.intro}</p>
        </div>
        <div class="mt-8" data-revelar>
          {sitio.faq.items.map((item) => (
            <details class="faq-item">
              <summary>{item.p}</summary>
              <p>{item.r}</p>
            </details>
          ))}
        </div>
      </Banda>

      {/* Contacto */}
      <Banda fondo="profundo" id="contacto">
        <div class="text-center" data-revelar>
          <h2 class="b-titulo">{sitio.contacto.titulo}</h2>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a href={`mailto:${sitio.contacto.correo}`} class="boton boton-amarillo">{sitio.contacto.correo}</a>
            <a href={sitio.contacto.catalogoUrl} target="_blank" rel="noopener" class="boton boton-fantasma">
              {sitio.contacto.catalogoNombre}
            </a>
          </div>
          <p class="mt-6" style="color:var(--mrc-crema)">{sitio.contacto.puntoVenta}</p>
        </div>
      </Banda>
    </main>

    <footer>
      <Banda fondo="profundo">
        <div class="flex flex-col items-center gap-2 text-center" style="border-top:1px solid var(--mrc-verde-700);padding-top:2rem">
          <p class="font-semibold" style="color:var(--mrc-crema)">{sitio.footer.leyenda}</p>
          <p class="b-menor">{sitio.footer.nota}</p>
        </div>
      </Banda>
    </footer>
  </div>
</Base>

<style>
  @media (prefers-reduced-motion: no-preference) {
    @keyframes flota-mini {
      0%, 100% { translate: 0 0; rotate: var(--rot); }
      50% { translate: 0 -10px; rotate: calc(var(--rot) + 3deg); }
    }
    .mini-flota {
      animation: flota-mini calc(var(--mrc-dur-ambiental) * 1.6) var(--mrc-ease-spring) infinite;
      animation-delay: calc(var(--mrc-dur-ambiental) * var(--fase) * -1);
    }
  }
</style>

<script>
  import '@/scripts/revelar'

  // El video del personaje respeta reduced-motion: quieto y con controles.
  const video = document.querySelector('.video-personaje video')
  if (video instanceof HTMLVideoElement && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.autoplay = false
    video.controls = true
    video.pause()
  }
</script>
