  @media (max-width: 760px) {
    .portada-logo { display: none; }
  }
  .portada-sello { display: inline-flex; width: clamp(220px, 26vw, 340px); }
  .portada-sello :global(svg) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 14px 30px rgb(76 44 22 / 0.2));
  }
  /* Centrar con tracking pide text-indent, no margen negativo (medido
     en el sistema anterior). */
  .portada-wordmark {
    font-family: var(--mrc-font-sello);
