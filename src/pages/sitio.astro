---
// src/pages/sitio.astro — El sitio público de Maracacao, rediseñado.
//
// Sistema: `src/styles/marca.css` — el empaque como sistema (diseño de
// Marcos en claude.ai/design, 2026-08-13; auditoría y correcciones en
// docs/auditoria-diseno-v2.md). La pieza firma es el anaquel: quince
// barras reales, la banda toma el color del sabor elegido y la tinta la
// pone `tintaSabor` (medida por sabor, nunca blanco fijo).
//
// Interacción en src/scripts/marca.ts: anaquel, menú, pestañas, cursor
// de sello, imanes y parallax — todo mejora progresiva sobre una página
// que sin JS se ve completa y quieta.
import Base from '@/layouts/Base.astro'
import BotonMarca from '@/components/marca/BotonMarca.astro'
import EtiquetaSabor from '@/components/marca/EtiquetaSabor.astro'
import Insignia from '@/components/marca/Insignia.astro'
import Marquesina from '@/components/marca/Marquesina.astro'
import TicketPanel from '@/components/marca/TicketPanel.astro'
import VisorProducto from '@/components/sitio/VisorProducto.astro'
import selloRaw from '@/assets/brand/sello-mano.svg?raw'
import { marca, precioMXN } from '@/copy/sitio-marca'
import { sabores, gotas, paqueteSeis, polvo, urlCatalogoBarras } from '@/copy/sabores'
import { sabor as colorSabor, tintaSabor, marca as paletaMarca } from '@/tokens/color'
import '@/styles/global.css'
import '@/styles/marca.css'

const sello = selloRaw.replace('<svg', '<svg aria-hidden="true" focusable="false"')

// La selección inicial del anaquel: canela (contraste AAA con blanco).
const inicial = sabores.find((s) => s.slug === 'canela')!

// La marquesina del hero lleva los QUINCE sabores, dos veces por tramo:
// con ocho, en pantallas muy anchas el tramo quedaba más angosto que la
// ventana y el bucle mostraba su costura (retro de Marcos). Con 30
// piezas el tramo mide ~4800px — cubre hasta un ultrawide.
const enMarquesina = [...sabores, ...sabores]

// Datos que el script del anaquel necesita por sabor, con el precio ya
// formateado y la tinta medida.
const datosAnaquel = sabores.map((s) => ({
  slug: s.slug,
  orden: s.orden,
  nombre: s.nombre,
  cacao: s.cacao,
  precio: precioMXN(s.precio),
  ingredientes: s.ingredientes,
  color: colorSabor[s.clave],
  tinta: tintaSabor[s.clave],
  // La página del producto; las barras que aún no existen en el
  // catálogo caen a la categoría de barras.
  url: s.catalogo ?? urlCatalogoBarras,
}))

// La tinta de un sabor es blanca o la de impreso: con distinguir la
// oscura alcanza (y el guard de hex a mano en páginas queda contento).
const tintaClara = (clave: keyof typeof tintaSabor) => tintaSabor[clave] !== paletaMarca.tintaImpreso
---
<Base titulo={marca.titulo} fuentes="marca" candado>
  <a href="#contenido" class="salto">{marca.skipLink}</a>

  <header class="cabecera" data-tono="crema">
    <div class="contenedor cabecera-fila">
      <a class="lockup" href="#contenido" aria-label={marca.marca.nombre}>
        <span class="lockup-sello" set:html={sello} />
        <span>
          <span class="lockup-nombre">{marca.marca.wordmark}</span>
          <span class="lockup-descriptor mono">{marca.marca.descriptor}</span>
        </span>
      </a>
      <button
        class="hamburguesa"
        type="button"
        aria-expanded="false"
        aria-controls="menu-principal"
        data-menu-boton
      >
        <span class="sr-only" data-menu-texto>{marca.nav.abrir}</span>
        <span class="hamburguesa-linea" aria-hidden="true"></span>
        <span class="hamburguesa-linea" aria-hidden="true"></span>
        <span class="hamburguesa-linea" aria-hidden="true"></span>
      </button>
    </div>
  </header>

  {/* Sin JS es una fila de enlaces bajo la cabecera; con JS, el overlay. */}
  <nav id="menu-principal" class="menu" aria-label={marca.nav.etiqueta} data-menu>
    <div class="menu-interior">
      <ol class="menu-lista">
        {marca.nav.items.map((item, i) => (
          <li style={`--orden:${i}`}>
            <a href={item.ancla} data-menu-enlace>
              <span class="menu-numero mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {item.texto}
            </a>
          </li>
        ))}
        <li class="menu-catalogo" style={`--orden:${marca.nav.items.length}`}>
          <a href={marca.contacto.catalogoUrl} target="_blank" rel="noopener" data-menu-enlace>
            <span class="menu-numero mano" aria-hidden="true">↗</span>
            {marca.nav.catalogo}<span class="sr-only"> (se abre en pestaña nueva)</span>
          </a>
        </li>
      </ol>
      <div class="menu-pie">
        {marca.nav.pie.map((linea) => <span class="mono">{linea}</span>)}
      </div>
      <img class="menu-personaje flota" src="/sitio/personaje-sentado-t.webp" alt="" width="300" height="352" loading="lazy" />
    </div>
  </nav>

  <main id="contenido">
    {/* ——— 01 · Portada ——— */}
    <section class="portada" data-tono="crema">
      <div class="contenedor portada-fila">
        <div class="portada-texto">
          <h1 class="portada-titular">
            {marca.hero.titular[0]}<br />
            {marca.hero.titular[1].replace(',', '')}<span class="acento">,</span><br />
            <span class="acento">{marca.hero.titular[2]}</span>
          </h1>
          <p class="portada-sub">{marca.hero.sub}</p>
          <div class="portada-ctas">
            <BotonMarca href={marca.contacto.catalogoUrl} externo>{marca.hero.ctaCatalogo}</BotonMarca>
            <a class="enlace-sabores" href="#sabores">{marca.hero.ctaSabores}</a>
          </div>
        </div>
        {/* El lockup del sistema anterior, que a Marcos le gustaba: el
            sello inline (vector, toma la tinta) y el wordmark como TEXTO
            VIVO en la serif del logotipo — más grande y nítido que el
            SVG calcado del logo completo. */}
        {/* Sin el descriptor debajo: «Chocolate mexicano» ya vive en el
            titular de al lado y en la cabecera — repetirlo era ruido. */}
        <div class="portada-logo">
          <span class="portada-sello" set:html={sello} />
          <p class="portada-wordmark">{marca.marca.wordmark}</p>
        </div>
      </div>
      <div class="portada-tira" data-parallax="0.045">
        {/* Carga inmediata: con lazy, las copias fuera de pantalla
            entraban tarde y se veían huecos en el bucle. */}
        <Marquesina aria={marca.hero.marquesinaAria} dur="140s" rotacion={-3}>
          {enMarquesina.map((s) => (
            <img
              class="tira-barra"
              src={`/sitio/marca/barra-${s.slug}-mini.webp`}
              alt=""
              width="380"
              height="815"
              loading="eager"
            />
          ))}
        </Marquesina>
      </div>
    </section>

    {/* ——— 02 · Qué hay en una barra ——— */}
    <section class="seccion" data-tono="calida">
      <div class="contenedor postura">
        <div>
          <EtiquetaSabor texto={marca.postura.kicker} />
          <h2 class="titular">{marca.postura.titulo}</h2>
          <p class="postura-intro">{marca.postura.intro}</p>
          <div class="chips">
            {marca.postura.chips.map((chip) => <Insignia tono="cacao">{chip}</Insignia>)}
          </div>
        </div>
        <div data-tabs>
          <div class="conmutador" role="tablist" aria-label={marca.postura.titulo}>
            <button type="button" role="tab" id="tab-si" aria-selected="true" aria-controls="panel-si" data-tab>
              {marca.postura.tabSi}
            </button>
            <button type="button" role="tab" id="tab-no" aria-selected="false" aria-controls="panel-no" data-tab>
              {marca.postura.tabNo}
            </button>
          </div>
          <div class="panel panel-si" id="panel-si" role="tabpanel" aria-labelledby="tab-si" tabindex="0" data-panel>
            <ul class="panel-lista">
              {marca.postura.lleva.map((item) => (
                <li><span class="mano panel-marca" aria-hidden="true">✓</span>{item}</li>
              ))}
            </ul>
            <p class="panel-nota mono">{marca.postura.llevaNota}</p>
          </div>
          {/* Sin `hidden` en el HTML: sin JS los dos paneles se apilan
              visibles; el script esconde el inactivo al tomar control. */}
          <div class="panel panel-no" id="panel-no" role="tabpanel" aria-labelledby="tab-no" tabindex="0" data-panel>
            <ul class="panel-lista">
              {marca.postura.noLleva.map((item) => (
                <li><span class="mano panel-marca" aria-hidden="true">✕</span><s>{item}</s></li>
              ))}
            </ul>
            <p class="panel-cierre">{marca.postura.noLlevaCierre}</p>
          </div>
        </div>
      </div>
    </section>

    {/* ——— 03 · El anaquel de los quince ——— */}
    <section id="sabores">
      <div
        class="anaquel"
        data-tono="sabor"
        data-anaquel-banda
        style={`--fondo:${colorSabor[inicial.clave]};--texto:${tintaSabor[inicial.clave]}`}
      >
        <div class="contenedor anaquel-encabezado">
          <EtiquetaSabor texto={marca.anaquel.kicker} />
          <span class="mono" aria-hidden="true"><span data-anaquel-contador>{inicial.orden}</span>/15</span>
        </div>
        <div class="contenedor">
          <h2 class="titular">{marca.anaquel.titulo}</h2>
        </div>
        <div class="anaquel-riel" role="radiogroup" aria-label={marca.anaquel.grupoAria} data-anaquel>
          {sabores.map((s) => (
            <button
              type="button"
              role="radio"
              aria-checked={s.slug === inicial.slug ? 'true' : 'false'}
              aria-label={s.nombre}
              data-anaquel-radio={s.slug}
              data-cursor="Ver"
            >
              <img
                src={`/sitio/marca/barra-${s.slug}-mini.webp`}
                alt=""
                width="380"
                height="816"
                loading="lazy"
              />
            </button>
          ))}
        </div>
      </div>

      <div class="contenedor ficha-zona">
        <article class="ficha" aria-live="polite">
          <div class="ficha-fila">
            <div class="ficha-envoltura">
              <VisorProducto
                imagen={`/sitio/marca/barra-${inicial.slug}.webp`}
                alt={`${marca.anaquel.envolturaAltPrefijo} ${inicial.nombre}`}
                ancho={754}
                alto={1620}
              />
            </div>
            <div class="ficha-datos">
              <p class="mono ficha-orden">
                {marca.anaquel.fichaEtiqueta} <span data-anaquel-orden>{inicial.orden}</span> {marca.anaquel.contadorDe}
              </p>
              <div class="ficha-nombre-fila">
                <h3 class="ficha-nombre" data-anaquel-nombre>{inicial.nombre}</h3>
                <p class="ficha-precio" data-anaquel-precio>{precioMXN(inicial.precio)}</p>
              </div>
              <div class="chips">
                <Insignia tono="rojo"><span data-anaquel-cacao>{inicial.cacao}</span></Insignia>
                <Insignia tono="cacao">{marca.anaquel.pesoInsignia}</Insignia>
                <Insignia tono="amarillo">{marca.anaquel.manoInsignia}</Insignia>
              </div>
              <p class="ficha-ingredientes mono">
                {marca.anaquel.ingredientesEtiqueta}: <span data-anaquel-ingredientes>{inicial.ingredientes}</span>.
              </p>
              <div class="ficha-ctas">
                <BotonMarca href={inicial.catalogo ?? urlCatalogoBarras} externo>{marca.anaquel.cta}</BotonMarca>
                <p class="mano ficha-remate suave">{marca.anaquel.remate}</p>
              </div>
            </div>
            <figure class="ficha-ilustracion">
              <img
                class="flota"
                src={`/sitio/marca/ilustracion-${inicial.slug}.webp`}
                alt={`${marca.anaquel.ilustracionAltPrefijo} ${inicial.nombre}`}
                width="400"
                height="450"
                loading="lazy"
                data-anaquel-ilustracion
              />
              <figcaption class="mano suave">{marca.anaquel.ilustracionCaption}</figcaption>
            </figure>
          </div>

          <div class="ficha-extras">
            <div class="extra-ticket">
              <TicketPanel>
                <p class="extra-titulo">{marca.minis.titulo} · {precioMXN(marca.minis.precio)}</p>
                <p class="extra-cuerpo">{marca.minis.cuerpo}</p>
                <p class="mano">{marca.minis.nota}</p>
              </TicketPanel>
            </div>
            <div class="extra-carta">
              <div class="extra-encabezado">
                <h4>{marca.gotas.titulo}</h4>
                <span class="mono extra-precio">{marca.gotas.desdeEtiqueta} {precioMXN(marca.gotas.precioDesde)}</span>
              </div>
              <p class="extra-cuerpo suave">{marca.gotas.cuerpo}</p>
              <ul class="gotas-puntos" aria-label={`${marca.gotas.sabores} de gotas`}>
                {gotas.map((g) => (
                  <li>
                    <span class="gota-punto" style={`background:${colorSabor[g.clave]}`} aria-hidden="true"></span>
                    <span class="sr-only">{g.nombre}</span>
                  </li>
                ))}
                <li class="mono gotas-cifra" aria-hidden="true">{marca.gotas.sabores}</li>
              </ul>
              <p class="mono extra-nota suave">{marca.gotas.notaPrecio}: {precioMXN(marca.gotas.precioJengibre)}</p>
            </div>
            <div class="extra-carta">
              <div class="extra-encabezado">
                <h4>{marca.polvoCard.titulo}</h4>
                <span class="mono extra-chip">{marca.polvoCard.chip}</span>
              </div>
              <p class="extra-cuerpo suave">{marca.polvoCard.cuerpo}</p>
              <p class="mono extra-lista">{polvo.map((p) => p.nombre.toLowerCase()).join(' · ')}</p>
            </div>
          </div>
        </article>
      </div>
    </section>

    {/* ——— 04 · Chocolate para beber (próximamente) ——— */}
    <section id="polvo" class="seccion" data-tono="oscuro">
      <div class="contenedor polvo-fila">
        <div class="polvo-texto">
          <div class="polvo-encabezado">
            <EtiquetaSabor texto={marca.polvo.kicker} />
            <span class="sello-pronto mano" aria-hidden="true">{marca.polvo.chip}</span>
            <span class="sr-only">{marca.polvo.chip}</span>
          </div>
          <h2 class="titular">{marca.polvo.titulo}</h2>
          <p class="suave">{marca.polvo.cuerpo}</p>
        </div>
        <div class="polvo-riel" role="region" aria-label={marca.polvo.titulo} tabindex="0" data-parallax="0.05">
          {polvo.map((p) => (
            <img
              src={`/sitio/${p.archivo}.webp`}
              alt={`${marca.polvo.altPrefijo} ${p.nombre}`}
              width="832"
              height="1600"
              loading="lazy"
            />
          ))}
        </div>
      </div>
    </section>

    {/* ——— 05 · Cómo catar ——— */}
    <section id="catar" class="seccion" data-tono="crema">
      <div class="contenedor">
        <EtiquetaSabor texto={marca.catar.kicker} />
        <h2 class="titular">{marca.catar.titulo}</h2>
        <ol class="catar-pasos">
          {marca.catar.pasos.map((paso, i) => (
            <li class="paso" data-revelar style={`--orden:${i % 3}`}>
              <span
                class="paso-numero mano"
                style={`background:${colorSabor[paso.clave]};color:${tintaSabor[paso.clave]}`}
                aria-hidden="true"
              >{i + 1}</span>
              <p><b>{paso.nombre}.</b> {paso.texto}</p>
            </li>
          ))}
        </ol>
        <div class="catar-cita">
          <TicketPanel>
            <p class="cita-texto">“{marca.catar.cita}”</p>
          </TicketPanel>
        </div>
        <div class="catar-notas">
          <p><b class="nota-titulo">{marca.catar.porqueTitulo}</b> {marca.catar.porque}</p>
          <p><b class="nota-titulo">{marca.catar.aporteTitulo}.</b> {marca.catar.aporte}</p>
        </div>
      </div>
    </section>

    {/* ——— 06 · Recetas ——— */}
    <section id="recetas" class="seccion" data-tono="calida">
      <div class="contenedor recetas-encabezado">
        <EtiquetaSabor texto={marca.recetas.kicker} />
        <span class="mano suave" aria-hidden="true">{marca.recetas.deslizaNota}</span>
      </div>
      <div class="contenedor"><h2 class="titular">{marca.recetas.titulo}</h2></div>
      <div class="recetas-riel" role="region" aria-label={marca.recetas.listaAria} tabindex="0">
        {marca.recetas.lista.map((r) => (
          <article
            class:list={['receta', tintaClara(r.clave) ? 'receta-clara' : 'receta-oscura']}
            style={`--sabor:${colorSabor[r.clave]};--tinta:${tintaSabor[r.clave]}`}
          >
            <p class="mono receta-kicker">{r.kicker}</p>
            <h3 class="receta-titulo">{r.titulo}</h3>
            <p class="receta-resumen">{r.resumen}</p>
            {'chipPolvo' in r && <p class="mono receta-chip">{r.chipPolvo}</p>}
            <div class="receta-tip mano"><b>{marca.recetas.etiquetaTip}:</b> {r.tip}</div>
            <details class="receta-completa">
              <summary>{marca.recetas.verCompleta}</summary>
              <ul>
                {r.ingredientes.map((ing) => <li>{ing}</li>)}
              </ul>
              <p>{r.pasos}</p>
            </details>
          </article>
        ))}
      </div>
    </section>

    {/* ——— 07 · Nosotros ——— */}
    <section id="nosotros" class="seccion" data-tono="crema">
      <div class="contenedor nosotros">
        <div>
          <EtiquetaSabor texto={marca.nosotros.kicker} />
          <h2 class="titular">{marca.nosotros.titulo}</h2>
          {marca.nosotros.parrafos.map((p) => <p class="nosotros-parrafo">{p}</p>)}
        </div>
        <div>
          <div class="nosotros-carta">
            <b class="nota-titulo">{marca.nosotros.cacaoTitulo}</b> {marca.nosotros.cacao}
          </div>
          <div class="nosotros-pie">
            <p class="mono suave">{marca.nosotros.datos.join(' · ')}</p>
            <img
              src="/sitio/personaje-sentado-t.webp"
              alt={marca.nosotros.personajeAlt}
              width="300"
              height="352"
              loading="lazy"
              data-parallax="-0.06"
            />
          </div>
        </div>
      </div>
    </section>

    {/* ——— 08 · Para negocios ——— */}
    <section id="negocios" class="seccion" data-tono="clara">
      {/* data-tabs va en el CONTENEDOR: pestañas y paneles viven en
          columnas distintas, y el script los busca dentro del grupo. */}
      <div class="contenedor negocios" data-tabs>
        <div>
          <EtiquetaSabor texto={marca.negocios.kicker} />
          <h2 class="titular">{marca.negocios.titulo}</h2>
          <p class="suave negocios-intro">{marca.negocios.intro}</p>
          <div class="pestanas" role="tablist" aria-label={marca.negocios.titulo}>
            {marca.negocios.tabs.map((t, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${t.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`panel-${t.id}`}
                data-tab
              >{t.etiqueta}</button>
            ))}
          </div>
          <dl class="semaforo">
            {marca.negocios.fichas.map((f) => (
              <div class="semaforo-fila">
                <dt>{f.dato}</dt>
                <dd class="mono">{f.estado}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="negocios-paneles">
          {marca.negocios.tabs.map((t, i) => (
            <div
              class="negocio-panel"
              id={`panel-${t.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${t.id}`}
              tabindex="0"
              data-panel
              style={`--sabor:${colorSabor[t.clave]}`}
            >
              <div class="negocio-encabezado">
                <h3>{t.titulo}</h3>
                <span class="mono">{t.precio === null ? t.precioNota : `${t.precioNota} ${precioMXN(t.precio)}`}</span>
              </div>
              <p class="negocio-cuerpo">{t.cuerpo}</p>
              <ul class="negocio-datos">
                {t.datos.map((d) => (
                  <li><span class="mano negocio-flecha" aria-hidden="true">→</span>{d}</li>
                ))}
              </ul>
              <p class="mono negocio-correo">{marca.negocios.correoEtiqueta} {marca.negocios.correo}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ——— 09 · Preguntas frecuentes ——— */}
    <section id="preguntas" class="seccion" data-tono="crema">
      <div class="contenedor preguntas">
        <EtiquetaSabor texto={marca.preguntas.kicker} />
        <h2 class="titular">{marca.preguntas.titulo}</h2>
        <div class="preguntas-lista">
          {marca.preguntas.items.map((item) => (
            <details class="pregunta">
              <summary>
                <h3>{item.p}</h3>
                <span class="pregunta-mas mano" aria-hidden="true">+</span>
              </summary>
              <p class="suave">{item.r}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* ——— 10 · Contacto ——— */}
    <section id="contacto" class="seccion" data-tono="calida">
      <div class="contenedor">
        <EtiquetaSabor texto={marca.contacto.kicker} />
        <h2 class="titular">{marca.contacto.titulo}</h2>
        {/* El formulario entero primero, la información abajo en texto —
            sin tarjetas (retro de Marcos). Sin servidor detrás: el envío
            arma un mailto con los datos y lo abre en el correo del
            visitante — la nota lo dice. */}
        <div class="contacto-zona">
          <form
            class="formulario"
            method="post"
            action={`mailto:${marca.contacto.correo}`}
            data-formulario
            data-asunto-personal={marca.contacto.formulario.asuntoPersonal}
            data-asunto-negocio={marca.contacto.formulario.asuntoNegocio}
            data-correo={marca.contacto.correo}
          >
            <h3 class="formulario-titulo">{marca.contacto.formulario.titulo}</h3>
            <div class="formulario-campos">
              <label>
                <span>{marca.contacto.formulario.nombre}</span>
                <input type="text" name="nombre" autocomplete="name" required />
              </label>
              <label>
                <span>{marca.contacto.formulario.correo}</span>
                <input type="email" name="correo" autocomplete="email" required />
              </label>
              <fieldset>
                <legend>{marca.contacto.formulario.tipo}</legend>
                {marca.contacto.formulario.tipoOpciones.map((op, i) => (
                  <label class="formulario-radio">
                    <input type="radio" name="tipo" value={op.valor} checked={i === 0} />
                    <span>{op.texto}</span>
                  </label>
                ))}
              </fieldset>
              <label class="campo-mensaje">
                <span>{marca.contacto.formulario.mensaje}</span>
                <textarea name="mensaje" rows="5" placeholder={marca.contacto.formulario.mensajeEjemplo} required></textarea>
              </label>
            </div>
            <div class="formulario-pie">
              <button class="formulario-enviar" type="submit" data-iman>{marca.contacto.formulario.enviar}</button>
              <p class="formulario-nota suave">{marca.contacto.formulario.nota}</p>
            </div>
          </form>
          <img
            class="contacto-personaje"
            src="/sitio/personaje-molinillo-t.webp"
            alt={marca.contacto.personajeAlt}
            width="300"
            height="323"
            loading="lazy"
            data-parallax="-0.05"
          />
        </div>

        <div class="contacto-info">
          <div class="info-bloque">
            <p class="mono info-etiqueta">{marca.contacto.correoEtiqueta}</p>
            <p class="info-dato">
              <a href={`mailto:${marca.contacto.correo}`}>{marca.contacto.correo}</a>
              <button class="copiar" type="button" data-copiar={marca.contacto.correo} hidden>
                <span data-copiar-texto>{marca.contacto.copiar}</span>
              </button>
            </p>
            <p class="info-nota suave">{marca.contacto.correoNota}</p>
          </div>
          <div class="info-bloque">
            <p class="mono info-etiqueta">{marca.contacto.puestoEtiqueta}</p>
            <p class="info-dato">{marca.contacto.puestoTitulo.join(' ')}</p>
            <p class="info-nota suave">{marca.contacto.direccion[0]} · {marca.contacto.direccion[1]}</p>
          </div>
          <div class="info-bloque">
            <p class="mono info-etiqueta">{marca.contacto.catalogoEtiqueta}</p>
            <p class="info-dato">
              <a href={marca.contacto.catalogoUrl} target="_blank" rel="noopener">
                {marca.contacto.catalogoNombre}<span class="sr-only"> (se abre en pestaña nueva)</span>
              </a>
            </p>
            <p class="info-nota suave">{marca.contacto.catalogoNota}</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="pie" data-tono="rojo">
    <div class="pie-marquesina">
      <Marquesina aria={marca.footer.lema} dur="24s">
        <span class="mono pie-lema">{marca.footer.lema} ·</span>
        <span class="mono pie-lema">{marca.footer.lema} ·</span>
      </Marquesina>
    </div>
    <div class="contenedor pie-cuerpo">
      {/* El lockup vectorial de verdad (retro de Marcos): el arco a mano
          imitaba la envoltura, pero el logo es el sello. En blanco sobre
          el rojo del pie. */}
      <div class="pie-marca">
        <span class="pie-sello" set:html={sello} />
        <p class="pie-wordmark">{marca.marca.wordmark}</p>
        <p class="mono pie-linea">{marca.footer.linea}</p>
      </div>
      <nav class="pie-columnas" aria-label="Mapa del sitio">
        <div>
          <p class="pie-titulo mano">{marca.footer.seccionesTitulo}</p>
          <ul>
            {marca.nav.items.map((item) => (
              <li><a href={item.ancla}>{item.texto}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="pie-titulo mano">{marca.footer.productosTitulo}</p>
          <ul>
            {marca.footer.productos.map((p) => (
              <li><a href={p.ancla}>{p.texto}</a></li>
            ))}
            <li>
              <a href={marca.contacto.catalogoUrl} target="_blank" rel="noopener">
                {marca.nav.catalogo}<span class="sr-only"> (se abre en pestaña nueva)</span>
              </a>
            </li>
          </ul>
        </div>
        <div>
          <p class="pie-titulo mano">{marca.footer.contactoTitulo}</p>
          <ul>
            <li><a href={`mailto:${marca.contacto.correo}`}>{marca.contacto.correo}</a></li>
            <li><a href="#contacto">{marca.contacto.puestoTitulo.join(' ')}</a></li>
            <li><span class="pie-suelto">{marca.contacto.direccion[1]}</span></li>
          </ul>
        </div>
        <div>
          <p class="pie-titulo mano">{marca.footer.legalesTitulo}</p>
          <ul>
            {/* Sin href a propósito: las páginas legales no existen
                todavía — la estructura queda lista para enchufarlas. */}
            {marca.footer.legales.map((l) => (
              <li><span class="pie-suelto">{l} <em>({marca.footer.legalesNota.toLowerCase()})</em></span></li>
            ))}
          </ul>
        </div>
      </nav>
    </div>
    <div class="contenedor pie-remate">
      <p class="mono">{marca.footer.derechos}</p>
    </div>
  </footer>

  <script type="application/json" id="datos-anaquel" set:html={JSON.stringify(datosAnaquel)} />
  <script>
    import '@/scripts/marca'
  </script>
</Base>

<style>
  /* ---------- Cabecera y menú ---------- */
  .cabecera {
