  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .menu, :global(html.js) .menu-lista a, .hamburguesa-linea { transition: none; }
  }

  /* ---------- Portada ---------- */
  /* Ocupa la ventana completa (menos la cabecera): el texto centra en el
     espacio libre y la marquesina se apoya abajo. */
  .portada {
    overflow: hidden;
    min-height: calc(100svh - 64px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-bottom: clamp(24px, 3vw, 48px);
  }
  .portada-fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(24px, 4vw, 48px);
    padding-top: clamp(28px, 5vw, 72px);
    flex: 1;
    align-content: center;
  }
  .portada-texto { flex: 1 1 340px; min-width: 0; }
  .portada-titular {
    font-family: var(--mrc-font-titular);
    font-weight: 800;
    font-size: clamp(2.875rem, 7vw, 5.25rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .acento { color: var(--mrc-marca-rojo); }
  .portada-sub {
    font-size: clamp(0.90625rem, 1.4vw, 1.0625rem);
    line-height: 1.6;
    max-width: 430px;
    margin: 16px 0 0;
  }
  .portada-ctas {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 24px;
  }
  .enlace-sabores {
    font-family: var(--mrc-font-titular);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--mrc-marca-tinta);
    text-decoration: none;
    border-bottom: 2px solid var(--mrc-marca-amarillo);
    padding-bottom: 2px;
    transition: border-color 0.2s;
  }
  .enlace-sabores:hover { border-color: var(--mrc-marca-rojo); }
  .portada-logo {
    flex: 1 1 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(14px, 1.6vw, 22px);
    color: var(--mrc-marca-tinta);
  }
  /* En móvil el lockup se va: el titular ya dice la marca y la pantalla
