  /* ---------- El anaquel ---------- */
  .anaquel { padding-block: clamp(40px, 6vw, 80px) clamp(56px, 7vw, 96px); position: relative; }
  .anaquel :global(.etiqueta-sabor) { color: var(--texto); --chispa: var(--mrc-marca-amarillo); }
  .anaquel-encabezado {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .anaquel .titular { margin: 6px 0 12px; }
  .anaquel-riel {
    display: flex;
    gap: clamp(14px, 1.8vw, 22px);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    /* La barra de scroll se tiñe con la tinta de la banda: visible como
       señal de que hay más (hallazgo de la auditoría), sin el gris crudo
       del navegador cruzando el color del sabor. */
    scrollbar-color: color-mix(in srgb, var(--texto) 45%, transparent) transparent;
    /* Aire vertical generoso: el lift de la selección (-10px) y la
       sombra (26px de difuminado) viven DENTRO del scroller — si no,
       el overflow los decapita (retro de Marcos). */
    padding: 20px clamp(20px, calc(50vw - 530px), 56px) 36px;
    /* En pantallas anchas entran las quince: que centren. `safe` vuelve
       al inicio cuando hay scroll, para no cortar la primera. */
    justify-content: safe center;
  }
  .anaquel-riel [role='radio'] {
    flex: none;
    scroll-snap-align: center;
    background: none;
    border: none;
    padding: 3px;
    border-radius: 7px;
    cursor: pointer;
    transition: transform 0.25s ease-out, box-shadow 0.25s ease-out;
  }
  .anaquel-riel [role='radio'] img {
    width: clamp(96px, 10vw, 126px);
    height: auto;
    border-radius: 3px;
    box-shadow: 0 14px 26px rgb(31 14 5 / 0.35);
    display: block;
  }
  .anaquel-riel [role='radio']:hover { transform: translateY(-10px) scale(1.04); }
  /* La seleccionada se marca con un anillo en la TINTA de la banda
     (contrasta siempre, porque la tinta se eligió contra este fondo) y
     una sombra más honda. El outline queda libre para el foco. */
  .anaquel-riel [role='radio'][aria-checked='true'] {
    transform: translateY(-8px) scale(1.06);
    box-shadow: 0 0 0 3px var(--texto);
  }
  .anaquel-riel [role='radio'][aria-checked='true'] img {
    box-shadow: 0 18px 34px rgb(31 14 5 / 0.48);
  }
  @media (prefers-reduced-motion: reduce) {
    .anaquel-riel [role='radio'], .tira-barra { transition: none; }
  }

  .ficha-zona { margin-top: -36px; position: relative; z-index: 2; padding-bottom: clamp(48px, 7vw, 96px); }
  .ficha {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 18px 40px rgb(76 44 22 / 0.22);
    padding: clamp(18px, 2.6vw, 32px);
  }
  .ficha-fila { display: flex; flex-wrap: wrap; gap: clamp(16px, 2.5vw, 36px); align-items: center; }
  .ficha-envoltura { flex: none; width: clamp(110px, 13vw, 164px); margin-inline: auto; }
  /* En móvil la envoltura grande sobra: la barra ya se ve seleccionada
     en el anaquel de arriba (retro de Marcos). */
  @media (max-width: 640px) {
    .ficha-envoltura { display: none; }
  }
  .ficha-envoltura :global(img) {
    width: 100%;
    height: auto;
    border-radius: 4px;
    box-shadow: 0 12px 26px rgb(76 44 22 / 0.3);
    transform: rotate(-2deg);
    transition: transform 0.25s ease-out;
  }
  .ficha-envoltura:hover :global(img) { transform: rotate(0deg) scale(1.03); }
  .ficha-datos { flex: 1 1 300px; min-width: 0; }
  .ficha-orden { color: var(--mrc-marca-textoSuave); letter-spacing: 0.14em; margin: 0; text-transform: uppercase; }
  .ficha-nombre-fila {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    margin-top: 4px;
  }
  .ficha-nombre { font-size: clamp(1.4375rem, 2.2vw, 1.875rem); font-weight: 400; margin: 0; }
  .ficha-precio {
    font-family: var(--mrc-font-titular);
    font-weight: 700;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    color: var(--mrc-marca-rojo);
    flex: none;
    margin: 0;
  }
  .ficha-datos .chips { margin: 10px 0 12px; }
  .ficha-ingredientes {
    background: var(--mrc-marca-crema);
    border: 1px solid rgb(76 44 22 / 0.25);
    border-radius: 6px;
    padding: 10px 14px;
    font-size: 0.75rem;
    letter-spacing: 0;
    line-height: 1.5;
    margin: 0;
  }
  .ficha-ctas { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; margin-top: 16px; }
  .ficha-remate { font-size: 0.875rem; margin: 0; }
  .ficha-ilustracion { flex: 0 1 190px; margin: 0 auto; text-align: center; }
  .ficha-ilustracion img {
    width: clamp(120px, 14vw, 180px);
    height: auto;
    filter: drop-shadow(0 8px 14px rgb(76 44 22 / 0.25));
  }
  .ficha-ilustracion figcaption { font-size: 0.78125rem; margin-top: 2px; }

  .ficha-extras {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 18px;
    border-top: 1px solid rgb(76 44 22 / 0.25);
    padding-top: 16px;
  }
  .extra-ticket { flex: 2 1 320px; display: flex; }
  .extra-ticket :global(.ticket) { width: 100%; }
  .extra-titulo { font-family: var(--mrc-font-titular); font-weight: 700; font-size: 1rem; margin: 0; }
  .extra-cuerpo { font-size: 0.84375rem; line-height: 1.5; margin: 4px 0 0; }
  .extra-ticket .mano { font-size: 0.8125rem; margin: 6px 0 0; }
  .extra-carta {
    flex: 1 1 220px;
    background: var(--mrc-marca-crema);
    border: 1px solid rgb(76 44 22 / 0.25);
    border-radius: 10px;
    padding: 16px;
    transition: transform 0.2s ease-out, box-shadow 0.2s ease-out;
  }
  .extra-carta:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgb(76 44 22 / 0.18); }
  .extra-encabezado { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .extra-encabezado h4 { font-family: var(--mrc-font-titular); font-weight: 700; font-size: 0.9375rem; margin: 0; }
  .extra-precio { font-size: 0.71875rem; color: var(--mrc-marca-rojoHondo); flex: none; }
  .extra-chip { font-size: 0.625rem; letter-spacing: 0.08em; color: var(--mrc-marca-rojoHondo); flex: none; }
  .extra-nota { font-size: 0.65625rem; letter-spacing: 0.02em; margin: 8px 0 0; }
  .gotas-puntos {
    list-style: none;
    display: flex;
    gap: 5px;
    align-items: center;
    margin: 10px 0 0;
    padding: 0;
  }
  .gota-punto { display: block; width: 12px; height: 12px; border-radius: 50%; }
  .gotas-cifra { font-size: 0.65625rem; color: var(--mrc-marca-textoSuave); margin-left: 4px; }
  .extra-lista { font-size: 0.65625rem; letter-spacing: 0.02em; line-height: 1.6; margin: 10px 0 0; }

  /* ---------- Chocolate para beber ---------- */
  .polvo-fila {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(20px, 3vw, 44px);
    align-items: center;
  }
  .polvo-texto { flex: 1 1 300px; }
  .polvo-texto :global(.etiqueta-sabor) { color: var(--mrc-marca-amarillo); --chispa: var(--mrc-marca-amarillo); }
  .polvo-encabezado { display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; }
  /* «Próximamente» como sello estampado, no como chip apretado: borde
     cosido (como el ticket), inclinado y con aire. */
  .sello-pronto {
    position: relative;
    display: inline-block;
    padding: 10px 20px;
    font-size: 1.0625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mrc-marca-amarillo);
    border: 2px solid var(--mrc-marca-amarillo);
    border-radius: 4px;
    transform: rotate(-4deg);
  }
  .sello-pronto::after {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1.5px dashed var(--mrc-marca-amarillo);
    border-radius: 2px;
    opacity: 0.75;
  }
  .polvo-texto .titular { margin: 10px 0 8px; }
  .polvo-texto p { font-size: 0.84375rem; line-height: 1.6; margin: 0; }
  .polvo-riel {
    flex: 1 1 340px;
    min-width: 0;
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--texto) 45%, transparent) transparent;
    padding: 6px 2px;
    will-change: transform;
  }
  .polvo-riel img {
    width: clamp(110px, 12vw, 150px);
    height: auto;
    border-radius: 6px;
    flex: none;
    box-shadow: 0 10px 22px rgb(31 14 5 / 0.4);
    transition: transform 0.25s ease-out;
  }
  .polvo-riel img:hover { transform: translateY(-6px) rotate(-1.5deg); }
  .polvo-riel img:nth-child(even):hover { transform: translateY(-6px) rotate(1.5deg); }
  @media (prefers-reduced-motion: reduce) { .polvo-riel img { transition: none; } }

  /* ---------- Cómo catar ---------- */
  #catar :global(.etiqueta-sabor) { color: var(--mrc-marca-rojoHondo); --chispa: var(--mrc-marca-rojo); }
  #catar .titular { margin: 8px 0 20px; }
  .catar-pasos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: clamp(14px, 2vw, 28px) clamp(14px, 2vw, 28px);
  }
  .paso {
    display: flex;
    gap: 14px;
    background: #fff;
    border-radius: 10px;
    padding: 14px 16px;
    box-shadow: 0 2px 6px rgb(76 44 22 / 0.14);
    transition: transform 0.2s ease-out, box-shadow 0.2s ease-out;
  }
  .paso:hover { transform: translateY(-3px); box-shadow: 0 10px 22px rgb(76 44 22 / 0.18); }
  .paso-numero {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    font-size: 1.125rem;
  }
  .paso p { font-size: 0.875rem; line-height: 1.5; margin: 0; }
  .paso b { color: var(--mrc-marca-rojoHondo); }
  .catar-cita { max-width: 640px; margin: 20px auto 0; }
  .cita-texto { font-size: 0.9375rem; line-height: 1.45; text-wrap: pretty; margin: 0; }
  .catar-notas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(14px, 2vw, 28px);
    border-top: 1px solid rgb(76 44 22 / 0.25);
    margin-top: 20px;
    padding-top: 14px;
  }
  .catar-notas p { font-size: 0.8125rem; line-height: 1.55; margin: 0; max-width: 720px; }
  .nota-titulo { color: var(--mrc-marca-rojoHondo); }

  /* ---------- Recetas ---------- */
  .recetas-encabezado { display: flex; justify-content: space-between; align-items: baseline; }
  #recetas :global(.etiqueta-sabor) { color: var(--mrc-marca-rojoHondo); --chispa: var(--mrc-marca-rojo); }
  #recetas .titular { margin: 6px 0 16px; }
  .recetas-riel {
    display: flex;
    gap: clamp(16px, 1.8vw, 24px);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--texto) 45%, transparent) transparent;
    padding: 8px clamp(20px, calc(50vw - 530px), 56px) 20px;
    /* Cuando las cuatro caben, la fila centra; si no, `safe` la vuelve
       alineada al inicio para que el scroll no corte la primera. */
    justify-content: safe center;
  }
  .receta {
    flex: none;
    width: min(330px, 76vw);
    scroll-snap-align: start;
    border-radius: 10px;
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    box-shadow: 0 10px 24px rgb(76 44 22 / 0.24);
    background: linear-gradient(
      168deg,
      color-mix(in srgb, var(--sabor) 85%, #fff) 0%,
      var(--sabor) 40%,
      color-mix(in srgb, var(--sabor) 78%, #000) 100%
    );
    color: var(--tinta);
    transition: transform 0.25s ease-out, box-shadow 0.25s ease-out;
  }
  .receta:hover { transform: translateY(-6px); box-shadow: 0 20px 36px rgb(76 44 22 / 0.32); }
  @media (max-width: 640px) {
    .receta { padding: 18px 16px; }
  }
  @media (prefers-reduced-motion: reduce) { .receta, .paso, .extra-carta { transition: none; } }
  .receta-kicker { font-size: 0.65625rem; letter-spacing: 0.1em; opacity: 0.88; margin: 0; }
  .receta-titulo {
    font-family: var(--mrc-font-titular);
    font-weight: 700;
    font-size: 1.28125rem;
    line-height: 1.18;
    letter-spacing: -0.01em;
    margin: 10px 0 12px;
    text-wrap: balance;
  }
  .receta-resumen { font-size: 0.84375rem; line-height: 1.6; margin: 0 0 auto; opacity: 0.96; }
  .receta-chip {
    display: inline-block;
    background: var(--mrc-marca-amarillo);
    color: var(--mrc-marca-rojoHondo);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    margin: 12px 0 0;
  }
  .receta-clara .receta-tip { background: rgb(255 255 255 / 0.16); }
  .receta-oscura .receta-tip { background: rgb(255 255 255 / 0.4); }
  .receta-tip { border-radius: 6px; padding: 10px 12px; margin-top: 16px; font-size: 0.84375rem; line-height: 1.45; }
  .receta-completa { margin-top: 14px; font-size: 0.8125rem; }
  .receta-completa summary {
    cursor: pointer;
    font-family: var(--mrc-font-titular);
    font-weight: 600;
    font-size: 0.8125rem;
  }
  .receta-completa ul { margin: 8px 0; padding-left: 18px; }
  .receta-completa p { margin: 8px 0 0; line-height: 1.5; }

  /* ---------- Nosotros ---------- */
  .nosotros {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(20px, 3.5vw, 48px);
    align-items: start;
  }
  #nosotros :global(.etiqueta-sabor) { color: var(--mrc-marca-rojoHondo); --chispa: var(--mrc-marca-rojo); }
  #nosotros .titular { margin: 8px 0 14px; }
  .nosotros-parrafo { font-size: 0.875rem; line-height: 1.65; margin: 0 0 12px; }
  .nosotros-carta {
    background: #fff;
    border: 1px solid rgb(76 44 22 / 0.25);
    border-radius: 10px;
    padding: 16px 18px;
    font-size: 0.84375rem;
    line-height: 1.55;
    box-shadow: 0 12px 28px rgb(76 44 22 / 0.16);
  }
  .nosotros-pie {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-top: 10px;
  }
  .nosotros-pie p { padding-bottom: 14px; margin: 0; font-size: 0.6875rem; }
  /* Más grande que en el canvas (120px): retro previa de Marcos — los
     personajes chicos «no viven». A 96px el trazo se empasta (medido);
     acá va holgado. */
  .nosotros-pie img { height: clamp(150px, 16vw, 190px); width: auto; will-change: transform; }

  /* ---------- Para negocios ---------- */
  .negocios {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(20px, 3.5vw, 48px);
    align-items: start;
  }
  #negocios :global(.etiqueta-sabor) { color: var(--mrc-marca-rojoHondo); --chispa: var(--mrc-marca-rojo); }
  #negocios .titular { margin: 8px 0 6px; }
  .negocios-intro { font-size: 0.84375rem; margin: 0 0 10px; }
  .pestanas { display: flex; gap: 4px; border-bottom: 1px solid rgb(76 44 22 / 0.25); }
  .pestanas [role='tab'] {
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    color: var(--mrc-marca-tinta);
    font-family: var(--mrc-font-serifMarca);
    font-size: 0.9375rem;
    padding: 8px 14px;
    margin-bottom: -1px;
    cursor: pointer;
    transition: color 0.15s ease-out;
  }
  .pestanas [role='tab'][aria-selected='true'] {
    border-bottom-color: var(--mrc-marca-rojo);
    color: var(--mrc-marca-rojoHondo);
  }
  .semaforo { margin: 12px 0 0; }
  .semaforo-fila {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: baseline;
    padding-block: 5px;
  }
  .semaforo dt { font-size: 0.78125rem; }
  .semaforo dd { margin: 0; font-size: 0.65625rem; color: var(--mrc-marca-textoSuave); text-align: right; }
  .negocios-paneles { display: flex; flex-direction: column; gap: 12px; }
  .negocio-panel {
    background: linear-gradient(168deg, color-mix(in srgb, var(--sabor) 88%, #fff) 0%, var(--sabor) 45%, color-mix(in srgb, var(--sabor) 80%, #000) 100%);
    color: #fff;
    border-radius: 10px;
    padding: 22px;
    min-height: 230px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    box-shadow: 0 16px 34px rgb(76 44 22 / 0.26);
  }
  .negocio-panel[hidden] { display: none; }
  .negocio-encabezado { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .negocio-encabezado h3 {
    font-family: var(--mrc-font-titular);
    font-weight: 700;
    font-size: 1.15625rem;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .negocio-encabezado .mono { font-size: 0.71875rem; color: rgb(255 255 255 / 0.88); flex: none; }
  .negocio-cuerpo { font-size: 0.84375rem; line-height: 1.55; color: rgb(255 255 255 / 0.95); margin: 8px 0 12px; }
  .negocio-datos { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .negocio-datos li { display: flex; gap: 9px; align-items: baseline; font-size: 0.78125rem; line-height: 1.45; }
  .negocio-flecha { color: var(--mrc-marca-amarillo); flex: none; }
  .negocio-correo {
    background: rgb(0 0 0 / 0.25);
    border-radius: 6px;
    padding: 10px 13px;
    margin: 14px 0 0;
    font-size: 0.71875rem;
    letter-spacing: 0.02em;
  }

  /* ---------- Preguntas ---------- */
  .preguntas { max-width: 780px; }
  #preguntas :global(.etiqueta-sabor) { color: var(--mrc-marca-rojoHondo); --chispa: var(--mrc-marca-rojo); }
  #preguntas .titular { margin: 8px 0 12px; }
  .pregunta { border-top: 1px solid rgb(76 44 22 / 0.25); }
  .pregunta summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 13px 8px;
    cursor: pointer;
    border-radius: 6px;
    list-style: none;
    transition: background 0.2s;
  }
  .pregunta summary::-webkit-details-marker { display: none; }
  .pregunta summary:hover { background: rgb(244 210 97 / 0.28); }
  .pregunta h3 {
    font-family: var(--mrc-font-titular);
    font-weight: 600;
    font-size: 0.90625rem;
    margin: 0;
    display: inline;
  }
  .pregunta-mas { font-size: 1.1875rem; color: var(--mrc-marca-rojoHondo); flex: none; transition: transform 0.25s ease-out; }
  .pregunta[open] .pregunta-mas { transform: rotate(45deg); }
  @media (prefers-reduced-motion: reduce) { .pregunta-mas { transition: none; } }
  .pregunta > p { font-size: 0.84375rem; line-height: 1.55; padding: 0 32px 14px 8px; margin: 0; }

  /* ---------- Contacto ---------- */
  #contacto :global(.etiqueta-sabor) { color: var(--mrc-marca-rojoHondo); --chispa: var(--mrc-marca-rojo); }
  #contacto .titular { margin: 8px 0 14px; }
  /* Formulario contenido y el personaje con protagonismo real a la
     derecha (retro de Marcos); en pantallas angostas el personaje se
     oculta para no estorbar. */
  .contacto-zona {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(20px, 4vw, 64px);
  }
  .contacto-personaje {
    flex: none;
    height: clamp(300px, 34vw, 460px);
    width: auto;
    margin-inline: auto;
    filter: drop-shadow(0 16px 28px rgb(76 44 22 / 0.22));
    will-change: transform;
  }
  @media (max-width: 820px) {
    .contacto-personaje { display: none; }
  }

  .formulario {
    flex: 0 1 640px;
    min-width: 0;
    background: #fff;
    border: 1px solid rgb(76 44 22 / 0.18);
    border-radius: 10px;
    box-shadow: 0 12px 28px rgb(76 44 22 / 0.16);
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(22px, 3vw, 36px);
  }
  .formulario-titulo {
    font-family: var(--mrc-font-titular);
    font-weight: 700;
    font-size: 1.28125rem;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .formulario-campos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 14px 20px;
    align-items: start;
  }
  .campo-mensaje { grid-column: 1 / -1; }
  .formulario-pie {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .formulario label:not(.formulario-radio) { display: flex; flex-direction: column; gap: 6px; }
  .formulario label span, .formulario legend {
    font-family: var(--mrc-font-titular);
    font-weight: 600;
    font-size: 0.8125rem;
  }
  .formulario input[type='text'],
  .formulario input[type='email'],
  .formulario textarea {
    font-family: var(--mrc-font-serifMarca);
    font-size: 0.9375rem;
    color: var(--mrc-marca-tinta);
    background: var(--mrc-marca-crema);
    border: 2px solid rgb(76 44 22 / 0.35);
    border-radius: 6px;
    padding: 9px 12px;
    transition: border-color 0.15s ease-out;
  }
  .formulario textarea { resize: vertical; min-height: 92px; }
  .formulario input:focus-visible, .formulario textarea:focus-visible {
    outline: none;
    border-color: var(--mrc-marca-rojo);
  }
  .formulario fieldset {
    border: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .formulario legend { padding: 0; margin-bottom: 8px; }
  .formulario-radio {
    display: flex;
    align-items: baseline;
    gap: 9px;
    font-size: 0.84375rem;
    cursor: pointer;
  }
  .formulario-radio input { accent-color: var(--mrc-marca-rojo); }
  .formulario-enviar {
    align-self: flex-start;
    font-family: var(--mrc-font-serifMarca);
    font-size: 1rem;
    line-height: 1.2;
    color: #fff;
    background: var(--mrc-marca-rojo);
    border: none;
    border-radius: 6px;
    padding: 12px 26px;
    cursor: pointer;
    box-shadow: 0 5px 0 0 color-mix(in srgb, var(--mrc-marca-rojoHondo) 70%, var(--mrc-marca-rojo));
    transition: transform 0.2s ease-out, box-shadow 0.2s ease-out, background 0.2s ease-out;
  }
  .formulario-enviar:hover {
    background: var(--mrc-marca-rojoHover);
    transform: translateY(-2px);
    box-shadow: 0 7px 0 0 color-mix(in srgb, var(--mrc-marca-rojoHondo) 70%, var(--mrc-marca-rojo));
  }
  .formulario-enviar:active { transform: translateY(3px); box-shadow: 0 2px 0 0 color-mix(in srgb, var(--mrc-marca-rojoHondo) 70%, var(--mrc-marca-rojo)); }
  .formulario-nota { font-size: 0.71875rem; line-height: 1.5; margin: 0; }
  @media (prefers-reduced-motion: reduce) {
    .formulario-enviar, .formulario-enviar:hover, .formulario-enviar:active { transition: none; transform: none; }
  }
  /* La información, en texto sobre la banda — sin tarjetas. */
  .contacto-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px clamp(24px, 4vw, 56px);
    border-top: 1px solid rgb(76 44 22 / 0.25);
    margin-top: clamp(24px, 3vw, 40px);
    padding-top: clamp(18px, 2.5vw, 28px);
  }
  .info-etiqueta { font-size: 0.625rem; color: var(--mrc-marca-rojoHondo); margin: 0 0 6px; }
  .info-dato {
    font-family: var(--mrc-font-titular);
    font-weight: 600;
    font-size: 1.0625rem;
    margin: 0;
