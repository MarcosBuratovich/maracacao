---
// src/pages/index.astro — Página EN CONSTRUCCIÓN.
// Es lo que ve quien entre por el dominio mientras el sitio se termina
// (decisión de Marcos, 2026-08-12). El changuito del cliente en
// movimiento, el lettering del empaque y dos salidas útiles: el catálogo
// (la venta ya existe ahí) y el correo. La presentación completa vive en
// /presentacion, el manual en /manual y el borrador en /sitio — sin
// enlaces desde acá: se comparten por URL directa.
import Base from '@/layouts/Base.astro'
import { svgDeMarca } from '@/components/brand/svg-inline'
import { sitio } from '@/copy/sitio'
import '@/styles/global.css'
import '@/styles/landing.css'

// El arco y el descriptor del empaque, en crema sobre la banda verde
// (par AAA aprobado). Mismo dimensionado que usan los componentes de
// marca: ancho fijo, altura por aspect ratio.
const arco = svgDeMarca('logotipo-arco').replace('<svg', '<svg width="100%"')
const descriptor = svgDeMarca('descriptor').replace('<svg', '<svg width="100%"')
---
<Base titulo={sitio.construccion.titulo}>
  <main class="banda" data-fondo="verde" style="min-height:100vh;min-height:100dvh;display:grid;place-items:center">
    <div class="flex max-w-lg flex-col items-center gap-5 px-6 py-12 text-center">
      <div class="w-56 sm:w-64 entra" aria-hidden="true">
        <span set:html={arco} />
      </div>

      <figure class="video-personaje entra entra-2" style="width:min(13rem,60vw)">
        <video
          src="/sitio/changuito-molinillo.mp4"
          poster="/sitio/changuito-molinillo-poster.jpg"
          muted
          loop
          playsinline
          autoplay
          preload="metadata"
          aria-label={sitio.construccion.videoAria}
          style="border-radius:999px;aspect-ratio:1;object-fit:cover;width:100%"
        ></video>
      </figure>

      <div class="w-40 sm:w-44 entra entra-2" aria-hidden="true">
        <span set:html={descriptor} />
      </div>

      {/* El descriptor dibujado ya dice "CHOCOLATE MEXICANO": sin overline
          que lo repita. */}
      <div class="entra entra-3">
        <h1 class="b-titulo">{sitio.construccion.encabezado}</h1>
        <p class="b-prosa mx-auto mt-4">{sitio.construccion.sub}</p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4 entra entra-4">
        <a href={sitio.contacto.catalogoUrl} target="_blank" rel="noopener" class="boton boton-amarillo">
          {sitio.construccion.ctaCatalogo}
        </a>
        <a href={`mailto:${sitio.contacto.correo}`} class="boton boton-fantasma">
          {sitio.construccion.ctaCorreo}
        </a>
      </div>

      <p class="b-menor entra entra-4" style="color:var(--mrc-crema)">{sitio.construccion.muyPronto}</p>
    </div>
  </main>
</Base>

<script>
  // El video respeta reduced-motion: quieto, con controles y su póster.
  const video = document.querySelector('.video-personaje video')
  if (video instanceof HTMLVideoElement && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.autoplay = false
    video.controls = true
    video.pause()
  }
</script>
