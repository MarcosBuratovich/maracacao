---
// src/pages/index.astro — Página EN CONSTRUCCIÓN.
// Lo que ve quien entra por el dominio mientras el sitio se termina.
// Mismo sistema editorial que /sitio: el sello se estampa, el wordmark
// abre su tracking en la tipografía del propio logotipo, y el canon
// marca sus registros. El personaje aparece al final, chico y en
// movimiento: la nota hecha a mano bajo la firma.
//
// El sitio completo vive en /sitio, la presentación en /presentacion y
// el manual en /manual — sin enlaces desde acá: van por URL directa.
import Base from '@/layouts/Base.astro'
import selloRaw from '@/assets/brand/sello-mano.svg?raw'
import { sitio } from '@/copy/sitio'
import '@/styles/global.css'
import '@/styles/editorial.css'

const sello = selloRaw.replace('<svg', '<svg aria-hidden="true" focusable="false"')
---
<Base titulo={sitio.construccion.titulo} fuentes="sitio">
  <div class="ed" data-tono="tinta">
    <main class="seccion portada">
      <div class="registro"><span></span><span></span></div>

      <div class="portada-centro">
        <div class="portada-sello sello estampa" set:html={sello} />
        <p class="monumento abre">{sitio.marca.wordmark}</p>
        <p class="marca portada-descriptor entra-suave" style="--retardo:900ms">
          {sitio.marca.descriptor}
        </p>

        <hr class="regla portada-regla entra-suave" style="--retardo:1050ms" />

        <h1 class="display portada-titulo entra-suave" style="--retardo:1150ms">
          {sitio.construccion.encabezado}
        </h1>
        <p class="cuerpo tenue portada-sub entra-suave" style="--retardo:1250ms">
          {sitio.construccion.sub}
        </p>

        <div class="portada-acciones entra-suave" style="--retardo:1350ms">
          <a
            class="cta cta-solido"
            href={sitio.contacto.catalogoUrl}
            target="_blank" rel="noopener"
            data-cursor={sitio.cursor.abrir} data-iman
          >
            <span class="cta-txt"><span>{sitio.construccion.ctaCatalogo}</span><span>{sitio.construccion.ctaCatalogo}</span></span>
            <span class="cta-flecha" aria-hidden="true">↗</span>
          </a>
          <a class="cta" href={`mailto:${sitio.contacto.correo}`} data-cursor={sitio.cursor.escribir} data-iman>
            <span class="cta-txt"><span>{sitio.construccion.ctaCorreo}</span><span>{sitio.construccion.ctaCorreo}</span></span>
            <span class="cta-flecha" aria-hidden="true">→</span>
          </a>
        </div>

        <figure class="portada-personaje entra-suave" style="--retardo:1500ms">
          <video
            src="/sitio/changuito-molinillo.mp4"
            poster="/sitio/changuito-molinillo-poster.jpg"
            muted loop playsinline autoplay preload="metadata"
            aria-label={sitio.construccion.videoAria}
          ></video>
        </figure>

        <ul class="portada-meta marca entra-suave" style="--retardo:1600ms">
          <li>{sitio.construccion.lugar}</li>
          <li>{sitio.construccion.muyPronto}</li>
        </ul>
      </div>
    </main>
  </div>
</Base>

<style>
  .portada {
    min-height: 100svh;
    display: grid;
    place-content: center stretch;
    overflow: hidden;
  }
  /* Ritmo ajustado para que la portada entre en una pantalla de 900 px
     sin scroll (medido en vivo: con el ritmo del sitio se pasaba). */
  .portada-centro { text-align: center; padding-block: clamp(2.5rem, 5vh, 4rem); }
  /* El padding va solo en los bloques de texto: al sello y al video,
     que tienen ancho fijo, los colapsaría (box-sizing border-box). */
  .portada-centro > :not(.monumento, .portada-sello, .portada-personaje) {
    padding-inline: clamp(1.25rem, 5.5vw, 5.5rem);
  }
  .portada-sello {
    width: clamp(5rem, 9vw, 8rem);
    margin: 0 auto clamp(1.5rem, 3.5vh, 2.5rem);
  }
  .portada-descriptor { margin-top: clamp(0.9rem, 2vh, 1.5rem); letter-spacing: 0.42em; }
  .portada-regla {
    width: min(90%, 30rem);
    margin: clamp(1.5rem, 3.5vh, 2.25rem) auto 0;
    padding: 0;
  }
  .portada-titulo { margin-top: clamp(1.5rem, 3.5vh, 2.25rem); }
  .portada-sub { margin: 1rem auto 0; max-width: 44ch; }
  .portada-acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: clamp(1.75rem, 3.5vh, 2.25rem);
  }
  .portada-personaje {
    width: clamp(4rem, 6vw, 5.5rem);
    margin: clamp(1.75rem, 3.5vh, 2.5rem) auto 0;
  }
  .portada-personaje video {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 999px;
    border: 1px solid var(--linea);
  }
  .portada-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 2.5rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding-inline: 1.25rem;
  }
  @media (max-width: 900px) {
    .portada-descriptor { letter-spacing: 0.3em; }
  }
</style>

<script>
  import '@/scripts/editorial'
</script>
