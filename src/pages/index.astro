---
// src/pages/index.astro — Página EN CONSTRUCCIÓN, en el sistema de
// MARCA (rediseño 2026-08-13): lo que ve quien entra por el dominio es
// la misma identidad que va a encontrar cuando el sitio salga — lockup
// vectorial, sello «Muy pronto» estampado, el personaje del molinillo
// en grande y la marquesina de barras reales al pie.
//
// Es la ÚNICA página sin candado: lo público mientras se termina.
import Base from '@/layouts/Base.astro'
import BotonMarca from '@/components/marca/BotonMarca.astro'
import Marquesina from '@/components/marca/Marquesina.astro'
import selloRaw from '@/assets/brand/sello-mano.svg?raw'
import { marca } from '@/copy/sitio-marca'
import { sabores } from '@/copy/sabores'
import { esquemaNegocio, origenCanonico } from '@/seo/esquema'
import '@/styles/global.css'
import '@/styles/marca.css'

const sello = selloRaw.replace('<svg', '<svg aria-hidden="true" focusable="false"')

// La misma tira del hero del sitio: quince sabores dos veces por tramo
// para que el bucle no muestre costura ni en ultrawide.
const enMarquesina = [...sabores, ...sabores]
---
<Base
  titulo={marca.construccion.titulo}
  fuentes="marca"
  descripcion={marca.descripcionConstruccion}
  ruta="/"
  esquema={esquemaNegocio(origenCanonico(Astro.site))}
>
  <main class="obra" data-tono="crema">
    <div class="obra-centro">
      <span class="obra-sello" set:html={sello} />
      <p class="obra-wordmark">{marca.marca.wordmark}</p>

      <span class="obra-pronto mano" aria-hidden="true">{marca.construccion.muyPronto}</span>
      <span class="sr-only">{marca.construccion.muyPronto}</span>

      <h1 class="obra-titulo">{marca.construccion.encabezado}</h1>
      <p class="obra-sub">{marca.construccion.sub}</p>

      <div class="obra-acciones">
        <BotonMarca href={marca.contacto.catalogoUrl} externo>{marca.construccion.ctaCatalogo}</BotonMarca>
        <a class="obra-correo" href={`mailto:${marca.contacto.correo}`}>{marca.construccion.ctaCorreo}</a>
      </div>

      <div class="obra-firma">
        <img
          src="/sitio/personaje-molinillo-t.webp"
          srcset="/sitio/personaje-molinillo-t-340.webp 340w, /sitio/personaje-molinillo-t.webp 460w"
          sizes="170px"
          alt={marca.construccion.personajeAlt}
          width="460"
          height="814"
          fetchpriority="high"
        />
        <p class="mono">{marca.construccion.lugar}</p>
      </div>
    </div>

    <div class="obra-tira">
      <Marquesina aria={marca.hero.marquesinaAria} dur="140s" rotacion={-3}>
        {enMarquesina.map((s) => (
          <img
            class="obra-barra"
            src={`/sitio/marca/barra-${s.slug}-mini.webp`}
            alt=""
            width="380"
            height="815"
            loading="eager"
            fetchpriority="low"
            decoding="async"
          />
        ))}
      </Marquesina>
    </div>
  </main>
</Base>

<style>
  .obra {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }
  .obra-centro {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(2rem, 5vh, 3.5rem) clamp(1.25rem, 5vw, 3rem) clamp(1rem, 2vh, 1.5rem);
  }
  .obra-sello { display: inline-flex; width: clamp(120px, 15vw, 190px); }
  .obra-sello :global(svg) { width: 100%; height: auto; }
  .obra-wordmark {
    font-family: var(--mrc-font-sello);
    font-weight: 500;
    font-size: clamp(1.75rem, 3vw, 2.625rem);
    letter-spacing: 0.18em;
    text-indent: 0.18em;
    line-height: 1;
    margin: clamp(10px, 1.6vh, 16px) 0 0;
  }
  /* El sello estampado del sistema (mismo mecanismo que el PRÓXIMAMENTE
     del sitio), acá en rojo sobre crema. */
  .obra-pronto {
    position: relative;
    display: inline-block;
    padding: 8px 18px;
    margin-top: clamp(18px, 3vh, 28px);
    font-size: 1rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    /* rojoHondo, no rojo: a 16px sobre crema, el rojo se queda en 4.23
       de contraste (Lighthouse); el hondo pasa AA sobrado. */
    color: var(--mrc-marca-rojoHondo);
    border: 2px solid var(--mrc-marca-rojoHondo);
    border-radius: 4px;
    transform: rotate(-4deg);
  }
  .obra-pronto::after {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1.5px dashed var(--mrc-marca-rojoHondo);
    border-radius: 2px;
    opacity: 0.75;
  }
  .obra-titulo {
    font-family: var(--mrc-font-titular);
    font-weight: 800;
    font-size: clamp(2.25rem, 5.2vw, 4rem);
    letter-spacing: -0.02em;
    line-height: 1.02;
    margin: clamp(16px, 2.6vh, 24px) 0 0;
    text-wrap: balance;
  }
  .obra-sub {
    font-size: clamp(0.90625rem, 1.3vw, 1.0625rem);
    line-height: 1.6;
    max-width: 46ch;
    margin: 14px 0 0;
  }
  .obra-acciones {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px;
    margin-top: clamp(20px, 3.2vh, 30px);
  }
  .obra-correo {
    font-family: var(--mrc-font-titular);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--mrc-marca-tinta);
    text-decoration: none;
    border-bottom: 2px solid var(--mrc-marca-amarillo);
    padding-bottom: 2px;
    transition: border-color 0.2s;
  }
  .obra-correo:hover { border-color: var(--mrc-marca-rojo); }
  .obra-firma {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-top: clamp(16px, 3vh, 26px);
  }
  .obra-firma img {
    width: clamp(110px, 13vh, 170px);
    height: auto;
    filter: drop-shadow(0 10px 18px rgb(76 44 22 / 0.2));
  }
  .obra-firma .mono { color: var(--mrc-marca-textoSuave); margin: 0; }

  .obra-tira { margin-inline: -14px; }
  .obra-tira :global(.marquesina) { padding-block: clamp(24px, 3vw, 40px); }
  .obra-barra {
    width: clamp(110px, 11vw, 160px);
    height: auto;
    border-radius: 4px;
    box-shadow: 0 12px 26px rgb(76 44 22 / 0.32);
  }
</style>

<script>
  import '@/scripts/marca'
</script>
